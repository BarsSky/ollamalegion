# Python caches
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd

# ============================================================
# CGo bridge + llama.cpp source (vendored in c/)
# These are not temporary — they're real project files.
# Uncomment the next line only if c/ is treated as disposable.
# /c/
# ============================================================

# Pre-migration backup of c/llama.cpp/ (created 2026-09-13 before vendor
# upgrade to upstream 1d2869c6e). Kept on disk for offline reference only.
# R66+ tracks c/llama.cpp/ as a git submodule (see .gitmodules).
c/llama.cpp.local-bak2/

# Submodule migration scratch dirs (2026-09-21). Created during the
# regular-tracked-dir → submodule conversion as intermediate rename
# targets. Safe to delete manually once R66+ submodule migration is
# stable in main.
c/llama.cpp.presubmodule-content*/

