# === R51.6 incremental rebuild — Go binary only ===
# Base = the previous working cppworker image with all CUDA/llama.cpp/bridge
# artifacts. We extract the build-time Go toolchain to recompile just the
# Go binary, then assemble a new runtime image with the same /app layout.
FROM ollama-legion/cppworker:gpu-86-r44-1-ollama-show-metadata AS source

# 1. Pull out the build artifacts we need (headers + static libs) from the
#    finished image. We use a scratch + copy pattern via an alpine extractor
#    rather than `cp` from a running container, which avoids depending on
#    the base image having a shell on PATH.
FROM alpine:3.18 AS extractor
RUN apk add --no-cache bash
COPY --from=source /build/ /work/build/
COPY --from=source /go/ /work/go/ 2>/dev/null || true

# 2. Bring in the source tree and rebuild just the Go binary.
FROM dockerhub.timeweb.cloud/nvidia/cuda:12.2.0-devel-ubuntu22.04 AS go-builder
ARG GO_VERSION=1.24.3
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget ca-certificates gcc g++ make libc6-dev && \
    wget -q --retry-connrefused --waitretry=5 --tries=5 --timeout=30 \
        "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -O /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz && \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go" \
    GOMODCACHE="/go/pkg/mod"

WORKDIR /build
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify
COPY . .

# Pull llama.cpp/bridge build artifacts (static libs + headers) from the
# finished image so we don't have to re-run cmake.
COPY --from=source /build/c/llama.cpp /build/c/llama.cpp
COPY --from=source /build/c/bridge /build/c/bridge

ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-DGGML_USE_CUDA -I/build/c/llama.cpp/include -I/build/c/llama.cpp/ggml/include -I/build/c/llama.cpp/ggml/src/ggml-cpu -I/build/c/bridge -I/usr/local/cuda/include -I/usr/local/cuda/targets/x86_64-linux/include -fopenmp"
ENV CGO_LDFLAGS="-L/build/c/llama.cpp/build/src -L/build/c/llama.cpp/build/ggml/src -L/build/c/llama.cpp/build/ggml/src/ggml-cuda -L/build/c/llama.cpp/build/common -L/build/c/bridge/build -L/usr/local/cuda/lib64 -L/usr/local/cuda/lib64/stubs -Wl,--start-group -lllama -lggml -lggml-cpu -lggml-base -lggml-cuda -lllama-common -lllama-common-base -lollamalegion_bridge -Wl,--end-group -lcublas -lcublasLt -lcudart -lcuda -lstdc++ -lm -lpthread -fopenmp"

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOMAXPROCS=2 \
    go build -trimpath -ldflags "-w -s" \
    -o cppworker ./cmd/cppworker

# 3. Final stage — same as runtime stage of the base image, just with the
#    freshly built /app/cppworker.
FROM dockerhub.timeweb.cloud/nvidia/cuda:12.2.0-runtime-ubuntu22.04 AS runtime
WORKDIR /app
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip libgomp1 && \
    pip3 install --no-cache-dir huggingface_hub && \
    rm -rf /var/lib/apt/lists/*
COPY docker/cppworker/entrypoint.sh /entrypoint.sh
COPY docker/cppworker/register-with-balancer.sh /register-with-balancer.sh
RUN chmod +x /entrypoint.sh /register-with-balancer.sh
COPY --from=go-builder /build/cppworker .
RUN mkdir -p /app/models && \
    groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -m -s /bin/sh appuser && \
    chown -R appuser:appgroup /app
USER appuser
EXPOSE 18092
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD /app/cppworker -healthcheck || exit 1
ENV CPPWORKER_PORT=18092 \
    CPPWORKER_HOST=0.0.0.0 \
    CPPWORKER_BALANCER_URL="" \
    CPPWORKER_BALANCER_TOKEN="" \
    CPPWORKER_ADVERTISE_HOST="" \
    CPPWORKER_ADVERTISE_PORT=18092 \
    CPPWORKER_REGISTER_RETRY_INTERVAL=30s \
    CPPWORKER_REGISTER_HEARTBEAT=60s \
    HF_HOME=/app/.cache/huggingface \
    HF_TOKEN="" \
    HF_AUTO_DOWNLOAD_REPO="" \
    HF_AUTO_DOWNLOAD_FILE="" \
    HF_AUTO_DOWNLOAD_QUANT="Q4_K_M" \
    HF_MIRROR=""
ENTRYPOINT ["/entrypoint.sh"]
LABEL org.opencontainers.image.title="Ollama Legion CppBackend Worker (GPU) - R51.6" \
      org.opencontainers.image.description="Incremental rebuild over r44-1-ollama-show-metadata: handleUnloadModel 409 safety, /api/models active_queries field, InjectLoadedModelForTest helper" \
      org.opencontainers.image.vendor="OllamaLegion" \
      org.opencontainers.image.version="0.1.0-r51.6" \
      org.opencontainers.image.source="https://github.com/BarsSky/ollamalegion"
