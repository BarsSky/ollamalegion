# ============================================
# Ollama Load Balancer - Agent Configuration
# ============================================
# Пример файла окружения для агента сбора метрик
#
# БЫСТРЫЙ СТАРТ (Linux/macOS):
#   1. Скопируйте этот файл: cp config/agent.example.env deployments/.env
#   2. Отредактируйте значения переменных ниже
#   3. Запустите: bash scripts/deploy-agent-docker.sh --env-file deployments/.env
#
# БЫСТРЫЙ СТАРТ (Windows PowerShell):
#   1. Скопируйте файл: Copy-Item "config\agent.example.env" "deployments\.env"
#   2. Отредактируйте значения: notepad "deployments\.env"
#   3. Запустите: .\scripts\deploy-agent-docker.ps1 -EnvFile "deployments\.env"
#
# РУЧНОЙ ЗАПУСК:
#   CPU сервер:
#     docker compose -f deployments/docker-compose.agent.yml --env-file deployments/.env up -d --build
#
#   GPU сервер:
#     docker compose -f deployments/docker-compose.agent.yml \
#       -f deployments/docker-compose.agent.gpu.yml \
#       --env-file deployments/.env up -d --build
#
# СКРИПТЫ АВТОМАТИЗАЦИИ:
#   Linux/macOS: bash scripts/deploy-agent-docker.sh --env-file deployments/.env
#   Windows:     .\scripts\deploy-agent-docker.ps1 -EnvFile "deployments\.env"

# ============================================
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# ============================================

# Уникальный идентификатор агента
# Должен совпадать с ID бэкенда в конфигурации балансировщика
# Примеры: gpu-1, server-a100, node-01
AGENT_ID=gpu-1

# URL балансировщика нагрузки
# Используйте IP адрес или hostname сервера с балансировщиком
# Формат: http://<host>:<port>
# По умолчанию используется порт 18081 (Management API)
# ВАЖНО: Используйте IP хоста, НЕ service name Docker!
BALANCER_URL=http://REPLACE_WITH_BALANCER_IP:18081

# Публичный IP/hostname этого агента, доступный балансеру
# Балансер использует этот адрес для health check и проксирования запросов к Ollama
# Пример: 192.168.1.20, gpu-server-1.example.com, host.docker.internal
# ВАЖНО: Должен быть доступен из сети балансировщика!
AGENT_PUBLIC_HOST=REPLACE_WITH_AGENT_PUBLIC_IP

# ============================================
# Настройки портов и Ollama
# ============================================

# Порт для локальных метрик агента
# На этом порту агент предоставляет свои метрики в формате Prometheus
AGENT_PORT=18032

# URL локального Ollama для получения метрик моделей
# Linux (docker): используйте IP хоста или host.docker.internal
# Windows/macOS: host.docker.internal работает из коробки
# Если Ollama запущена на хосте, используйте: http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434

# ============================================
# Режим работы платформы (auto / gpu / cpu)
# ============================================

# auto  - автоматическое определение GPU/CPU (по умолчанию)
# gpu   - принудительно GPU-режим, собирать GPU метрики
# cpu   - принудительно CPU-режим, пропускать GPU метрики
GPU_MODE=auto

# ============================================
# Настройки Docker build
# ============================================

# Базовый образ для runtime-контейнера
# Для CPU: оставьте ubuntu:22.04 (по умолчанию)
# Для GPU: nvidia/cuda:12.2.0-runtime-ubuntu22.04 (автоматически через docker-compose.agent.gpu.yml)
# BASE_IMAGE=ubuntu:22.04

# Включить NVML при сборке Docker-образа (build-time ARG)
# true  - собрать агента с NVML (GPU сервер, требуется CGO + gcc)
# false - собрать агента без NVML (CPU сервер, быстрее, меньше образ)
# 
# ВАЖНО: Это переменная для docker build (ENABLE_NVML). 
# Для runtime-включения NVML используйте NVML_ENABLED (см. ниже в секции GPU).
ENABLE_NVML=false

# ============================================
# Настройки лимитов Ollama
# ============================================

# Максимальное количество моделей (-1 = автоопределение по VRAM)
AGENT_MAX_MODELS=-1

# Максимальное количество одновременных запросов (-1 = автоопределение)
AGENT_MAX_CONCURRENT_REQUESTS=-1

# ============================================
# Интервалы сбора и отправки данных
# ============================================

# Интервал сбора метрик
# Поддерживаются переменные:
#   COLLECT_INTERVAL (рекомендуется) — интервал в секундах
#   METRICS_INTERVAL (устаревшая, оставлена для совместимости) — интервал в секундах
# Если заданы обе, приоритет у COLLECT_INTERVAL
# Если не задана ни одна, используется 5 секунд
COLLECT_INTERVAL=5

# Интервал отправки heartbeat сигналов балансировщику
# Должен быть меньше чем интервал проверки health на балансировщике
HEARTBEAT_INTERVAL=3

# ============================================
# Настройки логирования
# ============================================

# Уровень логирования
# Возможные значения: debug, info, warn, error
LOG_LEVEL=info

# Формат логов
# Возможные значения: text, json
LOG_FORMAT=text

# ============================================
# Дополнительные параметры (опционально)
# ============================================

# Путь к файлу конфигурации (если используется)
# CONFIG_PATH=/etc/ollama-legion/agent-config.json

# Таймаут подключения к балансировщику (секунды)
# CONNECTION_TIMEOUT=30

# Таймаут запроса к Ollama API (секунды)
# OLLAMA_TIMEOUT=120

# Включить подробное логирование метрик
# VERBOSE_METRICS=false

# ============================================
# GPU-специфичные настройки (только для GPU серверов)
# ============================================

# Эти настройки применяются только когда GPU_MODE=gpu и NVML_ENABLED=true
# Распределение нагрузки между GPU устройствами настраивается автоматически

# ============================================
# Примеры конфигураций для различных сред
# ============================================

# --------------------------------------------
# Локальная разработка (CPU)
# --------------------------------------------
# AGENT_ID=local-dev
# BALANCER_URL=http://localhost:18081
# AGENT_PUBLIC_HOST=host.docker.internal
# GPU_MODE=cpu
# NVML_ENABLED=false
# ENABLE_NVML=false
# LOG_LEVEL=debug

# --------------------------------------------
# Продакшн GPU сервер (NVIDIA A100/H100)
# --------------------------------------------
# AGENT_ID=gpu-server-prod-01
# BALANCER_URL=http://192.168.1.100:18081
# AGENT_PUBLIC_HOST=192.168.1.200
# GPU_MODE=gpu
# NVML_ENABLED=true
# ENABLE_NVML=true
# LOG_LEVEL=info
# LOG_FORMAT=json
# BASE_IMAGE=nvidia/cuda:12.2.0-runtime-ubuntu22.04

# --------------------------------------------
# Продакшн CPU сервер
# --------------------------------------------
# AGENT_ID=cpu-server-prod-01
# BALANCER_URL=http://192.168.1.100:18081
# AGENT_PUBLIC_HOST=192.168.1.201
# GPU_MODE=cpu
# NVML_ENABLED=false
# ENABLE_NVML=false
# LOG_LEVEL=info
# LOG_FORMAT=json

# --------------------------------------------
# Тестовый кластер (смешанный)
# --------------------------------------------
# AGENT_ID=test-cluster-node-1
# BALANCER_URL=http://lb-test:18081
# AGENT_PUBLIC_HOST=host.docker.internal
# GPU_MODE=auto
# METRICS_INTERVAL=10s
# HEARTBEAT_INTERVAL=5s

