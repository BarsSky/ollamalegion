# bundled-full environment variables
# Скопируйте в .env: `cp .env.example .env`
# Round 31 #6 (2026-08-09): default tag changed to gpu-86-abort-v2 (с Abort API).

# =============================================================================
# R66d (2026-09-23): ЕДИНЫЙ ИСТОЧНИК API-ТОКЕНА — ЭТОТ ФАЙЛ (`.env`).
# =============================================================================
#
# Токен один на весь стек: balancer <-> cppworker <-> agent <-> webui.
# Задавайте его ЗДЕСЬ и только здесь. Значение автоматически расходится по всем
# четырём сервисам из одного места:
#
#   .env: CPPWORKER_API_TOKEN=<token>
#          |
#          +--> balancer    LB_API_TOKEN
#          +--> cppworker   API_TOKEN + CPPWORKER_BALANCER_TOKEN
#          +--> agent       BALANCER_TOKEN
#          +--> webui       API_TOKEN
#
# ПОЧЕМУ НЕ .env.bundled-with-agent: это `env_file`, а `environment:` в compose
# переопределяет `env_file`. Поэтому старая строка CPPWORKER_API_TOKEN в
# .env.bundled-with-agent на сервисы НЕ влияет: compose подставляет значение из
# ЭТОГО файла (в живом .env.bundled-with-agent она закомментирована).
# Симптом расхождения — 401 в WebUI на load/unload/профили моделей:
#   "HTTP 401 : invalid or missing API token".
#
# ПОЧЕМУ НЕ только в Dockerfile/скрипте: `docker compose` интерполирует
# `${VAR:-default}` ТОЛЬКО из `.env` (файл без суффикса, рядом с
# docker-compose файлом). Значение в оболочке/скрипте тоже подхватывается, но
# `.env` — единственное, что видит и `docker compose up`, и пересборка образов.
#
# Смена токена (полный порядок, чтобы не получить 401):
#   1. отредактировать CPPWORKER_API_TOKEN здесь (в .env);
#   2. docker compose -f docker-compose.cppworker-bundled-with-agent.yml up -d
#      (пересоздаёт контейнеры с новым значением; пересборка образов НЕ нужна);
#   3. обновить токен в браузере: WebUI Settings -> API Token (или очистить
#      localStorage) и перезагрузить страницу — старый токен останется в JS.
#      WebUI при старте контейнера сам проверяет токен против балансера и
#      печатает в лог "API token check: OK" либо ERROR с этой инструкцией.
#
# Значение по умолчанию (dev only) = changeme-bundled-with-agent-token.
# Для production сгенерируйте: openssl rand -hex 24
CPPWORKER_API_TOKEN=changeme-bundled-with-agent-token

# === R83 (2026-09-25): теги образов продового стека ===
#
# 🐳 R83 (2026-09-28): локальный репозиторий образов.
# Пусто = стандартный путь (локальные образы ollama-legion/...).
# Иначе — адрес registry СО СЛЭШЕМ НА КОНЦЕ: compose склеивает строки
# буквально, и без слэша ссылка станет невалидной.
#   IMAGE_REGISTRY=local-docker-hub:5000/
#    → local-docker-hub:5000/ollama-legion/balancer:<тег>
# Значения local / docker.io / index.docker.io трактуются как «стандартный путь».
IMAGE_REGISTRY=
#
# Все четыре тега читаются ТОЛЬКО отсюда (docker compose интерполирует
# `${VAR:-default}` из этого файла; `env_file: .env.bundled-with-agent` на
# подстановку НЕ влияет). Compose при выпуске не правится: либо запустите
#   powershell -File scripts/release-all.ps1 -Tag <тег>
# который соберёт все компоненты и запишет теги одним заходом (+ манифест), либо
# поменяйте значения руками и пересоздайте: docker compose up -d.
#
# ВАЖНО: значение отсюда ПЕРЕОПРЕДЕЛЯЕТ default из compose. Значения ниже
# выставлены равными этим default'ам, чтобы `cp .env.example .env` не менял
# раскатанные образы.
# Проверка согласованности (docker не нужен, есть в CI):
#   powershell -File scripts/check-image-tags.ps1
#
# CppWorker image tag. Compose подставляет его как ollama-legion/cppworker:gpu-<value>,
# поэтому префикс "gpu-" здесь писать НЕ надо.
#
# R91 (2026-10-09): значения тегов синхронизированы с deployments/release-manifest.json
# (запись последнего выпуска). Раньше здесь жили значения, отставшие и от compose, и от
# манифеста: CI-шаг «Check image tag consistency» падал с пятью «рассинхрон выпуска»,
# то есть отслеживаемый контракт противоречил сам себе.
CPPWORKER_GPU_TAG=r83-submodule-v71

# Balancer image tag.
BALANCER_TAG=r83-submodule-v100

# WebUI image tag. НЕ путать с WEBUI_VERSION: та — build-arg образа
# (window.WEBUI_CONFIG.VERSION + токен cache-busting ?v=), а эта выбирает образ.
WEBUI_TAG=r83-submodule-v98

# Agent image tag.
AGENT_TAG=r83-submodule-v26

# R66d (2026-09-23): архитектура CUDA для сборки cppworker-gpu.
#
# ВАЖНО: значение нужно задавать ЗДЕСЬ (.env — источник интерполяции compose).
# `env_file: .env.bundled-with-agent` для этой переменной НЕ работает, а дефолт
# в compose — `${CUDA_ARCH:-all}`, то есть сборка под 9 архитектур (sm_50..sm_90)
# и время сборки в разы больше. Живой случай: после пересоздания Docker-данных
# сборка с дефолтом дошла до 25% за 40 минут; с CUDA_ARCH=86 (RTX 3070/A10,
# sm_86) — те же 25% за ~2-3 минуты.
# Другие значения: 89 (RTX 40xx), 90 (H100), 80 (A100).
CUDA_ARCH=86

# CppWorker config
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
# R83-фикс (2026-10-01): -1 = «все слои», а не жёсткие 20.
#
# Почему. С жёстким 20 модель на 8 GB карте работала наполовину на CPU: prefill
# 22 k токенов занимал ~300 с, и клиент (Cline, лимит 300 с) не дожидался
# первого токена. Теперь загрузка просит все слои, а memfit срезает до того, что
# реально влезает в VRAM (RTX 3070 8 GB, gemma-4 Q4_K_M — 35 из 43).
# Замер после фикса: тот же промпт 22 285 токенов — prefill 72.6 с (было 296 с).
CPPWORKER_GPU_LAYERS=-1
CPPWORKER_FLASH_ATTN_TYPE=-1
CPPWORKER_USE_MMAP=true
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true

# nCtx reload config (Round 31 #2)
LB_NCTX_RELOAD_ENABLED=true
LB_NCTX_RELOAD_MAX_N_CTX=131072
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
LB_NCTX_RELOAD_TIMEOUT_SEC=120
LB_NCTX_PREFLIGHT_ASYNC_RELOAD=true
LB_NCTX_PREFLIGHT_ASYNC_RETRY_AFTER_SEC=5

# --- Опт-ин таймауты (R83/v67, 2026-10-02) -------------------------------------
# По умолчанию НИ ОДИН из этих капов не взведён: стенд ждёт терминального
# состояния (успех / ошибка / недоступность бэкенда / закрытие клиентом), а не
# «N секунд по часам». Взводите значение только осознанно — при старте появится
# WARN с именем переменной. Полное описание: docs/deployment-stack.md §7.6.
#
# # таймауты из per-model профилей (WebUI) и адаптивный per-request таймаут
# LB_ALLOW_PROFILE_TIMEOUTS=1
# LB_ALLOW_REQUEST_TIMEOUTS=1
# # HTTP-клиент операций с моделью (pull/push/show/create) и загрузки модели
# LB_ALLOW_MODEL_OP_TIMEOUT_SEC=600
# LB_ALLOW_MODEL_LOAD_TIMEOUT_SEC=600
# # ожидание готовности модели (poll-циклы) и reload/preflight контекста
# LB_ALLOW_LOAD_WAIT_CAP_SEC=900
# LB_ALLOW_NCTX_RELOAD_TIMEOUT=1
# # ожидание первого async-reload: N секунд, 0 = не ждать вовсе
# # (по умолчанию ждём завершения reload — перезагрузка A10 длится минуты)
# LB_NCTX_PREFLIGHT_WAIT_SEC=240
# # бюджет ожидания авто-загрузки: N секунд, 0 = не ждать, <0 = до потолка
# LB_AUTO_LOAD_WAIT_SEC=180
# # HTTP-сервер cppworker: 0 = без ограничения (дефолт)
# CPPWORKER_WRITE_TIMEOUT=30m
# CPPWORKER_READ_TIMEOUT=30s
# # контекст разделяемой (ленивой) загрузки модели: по умолчанию без капа
# CPPWORKER_LAZY_LOAD_TIMEOUT_SEC=1800

# Round 31 #1: auto-stream workaround для non-streaming /v1/chat/completions.
#
# R66c (2026-09-22): ЭТОТ ФАЙЛ (`.env`) compose использует ТОЛЬКО для
# интерполяции `${VAR:-...}` в docker-compose.yml и НЕ передаёт своё
# содержимое в контейнер. Переменные попадают в контейнер через
# `env_file: .env.bundled-with-agent` (см.
# docker-compose.cppworker-bundled-with-agent.yml). Поэтому флаг,
# выставленный здесь, на балансер не влияет — именно так «терялся»
# LB_OPENAI_AUTO_STREAM. Задавайте его в .env.bundled-with-agent.
#LB_OPENAI_AUTO_STREAM=true

# Misc
NVIDIA_VISIBLE_DEVICES=all
LB_LOG_LEVEL=info

# =============================================================================
# R67a (2026-09-23): авто-загрузка модели и потолки n_ctx
# =============================================================================
#
# LB_AUTO_LOAD_WAIT_SEC — сколько ЖДАТЬ завершения авто-загрузки модели, прежде
# чем вернуть клиенту 503+Retry-After. Раньше балансер сразу отвечал 503
# «model X load started, waiting ~30-180s», и клиент (OpenWebUI) показывал
# ошибку — проходил только повторный запрос. Теперь первый же запрос дожидается
# загрузки (значение = сколько секунд ждать).
#   180 (default) — покрывает загрузку 2-20 ГБ моделей на нормальном GPU;
#   0             — прежнее поведение (сразу 503, клиент повторяет запрос);
#   отрицательное — ждать сколько потребуется (до 30 мин).
LB_AUTO_LOAD_WAIT_SEC=180

# LB_NCTX_RELOAD_MAX_N_CTX — жёсткий потолок n_ctx для авто-reload (default
# 131072). Если модель поддерживает больше (GGUF max до 262144) и VRAM
# позволяет — поднимите значение. Раньше на мощном GPU это воспринималось как
# «n_ctx жёстко ограничен», хотя фактический потолок считает cppworker по VRAM.
LB_NCTX_RELOAD_MAX_N_CTX=131072

# CPPWORKER_VRAM_OVERHEAD_MB — сколько VRAM резервировать при расчёте доступного
# n_ctx (default 2048). На картах с большим объёмом (A10 24GB) резерв можно
# уменьшить (например 512), чтобы получить больший допустимый контекст.
CPPWORKER_VRAM_OVERHEAD_MB=2048

# CPPWORKER_TOOLS_STREAM_CONTENT — потоковая отдача ответа на пути /api/chat с
# tools (default true).
#
# ЗАЧЕМ. До R83/v56 ответ с tools буферизовался целиком и уходил одним финальным
# чанком: пока модель генерировала, клиент получал только {"keepalive":true}.
# На медленном инстансе (5-9 tok/s) Cline отваливался по своему таймауту с
# «Model returned empty response», хотя модель продолжала работать
# (/debug/last-stream: tokens_sent=0, bytes_written=380 за 306 с).
#
# Теперь prose уходит дельтами, а маркер tool call удерживается окном 32 байта
# (в content он не попадает). Значение false возвращает прежнее поведение —
# рубильник на случай клиента, который не умеет собирать дельты.
CPPWORKER_TOOLS_STREAM_CONTENT=true

# CPPWORKER_EMPTY_OUTPUT_RETRY — повторять генерацию, если модель не выдала ни
# одного байта (default true).
#
# ЗАЧЕМ. Живой факт стенда (R83/v59, пробник debug/streamprobe): gemma-4-E4B
# иногда завершает ход первым же токеном EOG — в логе cppworker
# «inference вернула пустой вывод — отдаём error-чанк, raw_len=0», а клиент
# (Cline) показывает «model produced an empty response» и не может ни понять
# причину, ни повторить. Сэмплирование стохастично, поэтому один повторный
# проход обычно даёт нормальный ответ; при raw_len=0 клиенту ещё не отправлено
# ни одного чанка, так что повтор ничего не ломает.
CPPWORKER_EMPTY_OUTPUT_RETRY=true

# =============================================================================
# R67b (2026-09-23): admission-очередь вместо «резкого 503»
# =============================================================================
#
# Жалоба: «балансер резко отбивает повторный запрос от клиента выдавая 503, а не
# поставляя в очередь… не различает разных пользователей OpenWebUI».
#
# LB_ADMISSION_WAIT_SEC — сколько ЖДАТЬ свободный слот бэкенда
# (maxConcurrentRequests), прежде чем вернуть 503+Retry-After:
#   300 (default) — запрос ждёт освобождения слота и обслуживается ПЕРВЫМ же
#                   запросом (никаких «повторите запрос»);
#   0             — прежнее поведение (сразу 503, если слот занят);
#   отрицательное — ждать до отключения клиента (не дольше 30 мин).
# Ожидающие видны в GET /api/v1/queue/stats (поле "admission").
LB_ADMISSION_WAIT_SEC=300

# LB_ADMISSION_KEEPALIVE_SEC (R70) — период keepalive для streaming-клиента,
# который ждёт свободный слот: SSE получает `: keepalive`, Ollama-NDJSON —
# пустую строку. Клиент (OpenWebUI/Cline, таймаут 300 с) видит трафик и не
# закрывает соединение. 0 = выключить (прежнее поведение: молча ждём и отдаём
# X-Queue-Wait-Ms/X-Queue-Position). Default 5.
LB_ADMISSION_KEEPALIVE_SEC=5

# =============================================================================
# R93 (2026-10-09): живой инвентарь моделей (наличие файлов на диске)
# =============================================================================
#
# ЗАЧЕМ. Каталог моделей может меняться без перезапуска контейнера (оператор
# удалил/скачал GGUF, docker cp, отвалился/подключился том). Раньше список .gguf
# читался только на старте воркера и после import/share: удалённые модели
# оставались в WebUI «призраками» до рестарта, а новые не появлялись.
#
# Теперь работают два независимых цикла плюс ручная проверка:
#   * CPPWORKER_MODELS_RESCAN_SEC — воркер сам сверяет каталог с диском
#     (default 30; 0 = выключить фоновую проверку). Изменения (added/removed/
#     resized) попадают в лог воркера; /api/models/files пересканирует каталог по
#     этому TTL, а POST /api/models/refresh — немедленно.
#   * LB_MODEL_CATALOG_REFRESH_SEC — балансер перечитывает листинги воркеров
#     (default 60; 0 = выключить). Изменение состава моделей логируется и
#     публикуется в ленту событий WebUI (колокольчик/recent errors).
#   * Кнопка «Проверить наличие» на вкладке «Модели» (WebUI) дёргает
#     POST /api/models/refresh через прокси балансера — без ожидания циклов.
#
# Недоступный каталог (удалённый bind-mount) больше НЕ показывается как «моделей
# нет»: API отдаёт dirError, а WebUI пишет причину в панели «Модели».
#
# CPPWORKER_MODELS_RESCAN_SEC=30
# LB_MODEL_CATALOG_REFRESH_SEC=60
# LB_CAPACITY_FROM_MODEL_SLOTS (R83, 2026-09-29) — считать вместимость бэкенда
# по ФАКТИЧЕСКИМ слотам загруженной модели (cppworker отдаёт max_slots в
# /api/models), а не по статическому maxConcurrentRequests.
#
#   false (default) — как раньше: вместимость = runtime/статический лимит;
#   true            — балансер пропускает столько запросов, сколько слотов
#                     реально заведено у модели (n_parallel).
#
# ЗАЧЕМ ЗНАТЬ. Если воркер держит модель с n_parallel=2, а балансер пропускает 1,
# половина слотов простаивает. WebUI (Monitor) показывает это предупреждением
# «потенциал параллельности не раскрыт» в ленте алертов, называя оба числа и этот
# флаг как вариант решения. Балансер сам НИЧЕГО не переключает: авто-привязка
# меняет поведение admission-очереди, поэтому включает её оператор.
# Альтернатива для одного бэкенда: maxConcurrentRequests=<слоты> в его настройках.
# LB_CAPACITY_FROM_MODEL_SLOTS=false

# =============================================================================
# R68 (2026-09-23): n_ctx reload — дожидаться, а не отбивать клиента
# =============================================================================
#
# Жалоба (реальный клиент Cline): «Model Context Window = 65536» падал с
#   413 preflight: prompt + n_predict exceeds n_ctx for this backend
#       (requested n_ctx=65536 exceeds model max context=8192)
# хотя GGUF держит 131072, а cppworker сообщал max_vram_n_ctx ~66-91K. Причина:
# contextLength профиля модели (hint для первичной загрузки) использовался как
# потолок для клиента. Теперь клиентский потолок = min(GGUF max, operator cap),
# а сам reload ДОЖИДАЕТСЯ, как авто-загрузка в R67a.
#
# LB_NCTX_PREFLIGHT_WAIT_SEC — сколько ЖДАТЬ завершения reload n_ctx:
#   240 (default) — первый же запрос дожидается и обслуживается;
#   0             — прежнее поведение (503 + Retry-After / stream-dialog);
#   отрицательное — ждать до отключения клиента (не дольше 30 мин).
LB_NCTX_PREFLIGHT_WAIT_SEC=240

# KV-cache по умолчанию для моделей БЕЗ своего профиля (R83/v62, 2026-10-02):
# раньше дефолт был f16 и оператор не видел этого ни в WebUI, ни в логах.
# q4_0 экономит VRAM на порядок; выберите f16/q8_0, если нужно качество.
CPPWORKER_KV_CACHE_TYPE=q4_0

# =============================================================================
# R-Image (2026-09-27): ImageWorker — генерация изображений (порт 18093)
# =============================================================================
# Сервис `imageworker` поднимается в docker-compose.stack.yml (профили
# worker|full) и в docker-compose.bundled-full.yml (там он включён по умолчанию,
# без профиля). Бэкенд типа image_cpp: СВОЙ движок (stable-diffusion.cpp) и свой
# каталог моделей, регистрируется в балансере САМ (Go-side, imagePort=18093).
# Клиенты ходят на OpenAI-поверхность балансера: http://<хост>:18079/v1/images/*
#
# Выключить (образ не собран / GPU занят текстовой моделью):
#   docker compose -f docker-compose.stack.yml --profile full up -d --scale imageworker=0
#
# Тег образа. Полное имя: ollama-legion/imageworker:<тег>.
# Синхронизирован с release-manifest.json (R91, 2026-10-09); `vulkan` — дефолт
# compose, который используется, если переменную не задавать вовсе.
IMAGE_WORKER_TAG=r83-submodule-v85
# Ревизия + ассет движка sd.cpp (совпадает с types.PinnedSDServerRevision).
#   Vulkan (основной): sd-master-3f8527a-bin-Linux-Ubuntu-24.04-x86_64-vulkan.zip
#   CPU              : sd-master-3f8527a-bin-Linux-Ubuntu-24.04-x86_64.zip
# ⚠️ Linux-CUDA-сборок stable-diffusion.cpp НЕ выпускает (CUDA есть только под
# Windows), поэтому CUDA-вариант = свой бинарь (см. ниже), не смена ассета.
SD_SERVER_REVISION=master-929-3f8527a
SD_SERVER_ASSET=sd-master-3f8527a-bin-Linux-Ubuntu-24.04-x86_64-vulkan.zip
# CUDA-вариант: свой sd-server — ИМЯ ФАЙЛА в docker/imageworker/vendor/
# (готовых Linux-CUDA-релизов нет) + база с CUDA-рантаймом, потому что
# nvidia-container-runtime монтирует только драйвер, а не libcudart/libcublas.
#SD_SERVER_BIN=sd-server-cuda
#IMAGE_WORKER_RUNTIME_BASE=nvidia/cuda:12.6.0-runtime-ubuntu24.04
#
# Внешний порт API воркера (внутри контейнера всегда 18093).
SDWORKER_PORT=18093
# Внутренний порт самого sd-server (loopback ВНУТРИ контейнера).
SDWORKER_SD_SERVER_PORT=18094
# Базовый URL воркера «глазами клиента» — попадает в ответ при
# response_format:"url". Для клиентов НЕ с этой машины: http://<хост>:18093.
SDWORKER_BASE_URL=http://localhost:18093
# Выгрузка простаивающей модели, минуты (0 = держать загруженной).
SDWORKER_IDLE_UNLOAD_MINUTES=30
# Размер очереди генераций и кап времени на одну генерацию (секунды).
SDWORKER_MAX_CONCURRENT=64
# R88: кап времени — ТОЛЬКО opt-in (доктрина таймаутов проекта): по умолчанию
# капа нет, воркер ждёт терминального состояния джобы (completed/failed/
# cancelled). Ненулевое значение ОБОРВЁТ длинную генерацию: 2048x2048/40 шагов
# на RTX 3070 — ~22 минуты. См. docs/image-generation.md §17.
SDWORKER_GENERATION_TIMEOUT_SEC=0
# R88: кап ожидания readiness sd-server. 0 = ждать ready ИЛИ смерти процесса
# (это терминальное состояние с внятной ошибкой в логе).
SDWORKER_STARTUP_TIMEOUT_SEC=0
# R88: разрешить per-model profile.timeoutSec обрывать генерацию. По умолчанию
# профильный кап ИГНОРИРУЕТСЯ (значение в profile.json не должно молча резать
# легитимную работу) — ровно как LB_ALLOW_PROFILE_TIMEOUTS у текстового бэкенда.
#SDWORKER_ALLOW_PROFILE_TIMEOUTS=on
# Модель для предзагрузки при старте (пусто = грузить по запросу).
#SDWORKER_PRELOAD_MODEL=
#
# Где лежат модели: bundle = каталог <MODELS_DIR>/image/<имя>/ с файлами движка
# (diffusion + VAE + text encoders) и profile.json. Пустой каталог — не ошибка:
# воркер поднимется, /health=200, генерация ответит model_not_found.
# Один каталог с cppworker (MODELS_DIR) — .gguf в корне, image-bundle'ы в image/.
#
# Внешний порт OpenAI-поверхности балансера (внутри контейнера 18079,
# loadBalancer.openAIPort). Меняет только ВНЕШНИЙ порт.
#LB_OPENAI_PORT=18079
#
# ── ВЫБОР ДВИЖКА ОБРАЗА (Phase 8) ────────────────────────────────────────────
# Цель сборки решает, какой sd.cpp попадёт в образ:
#   imageworker-vulkan (дефолт) — релизный Vulkan-ассет (AMD/Intel, NVIDIA там,
#     где проброшен nvidia-ICD);
#   imageworker-cuda — сборка sd.cpp из исходников с CUDA (Linux-CUDA-релиза у
#     проекта нет). Нужна там, где Vulkan-NVIDIA в контейнер НЕ приезжает:
#     например, Windows + Docker Desktop/WSL2 — nvidia-smi карту видит, а
#     nvidia_icd.json отсутствует, и Vulkan-движок уходит на CPU (замер:
#     512x512/8 шагов 251 с против 4-20 с на CUDA).
# Для CUDA обязателен RUNTIME_BASE с CUDA-рантаймом (libcudart/libcublas).
# Сборка CUDA компилирует ggml: на 8 ядрах ~25 минут, кэшируется по слоям.
#IMAGE_WORKER_BUILD_TARGET=imageworker-vulkan
#IMAGE_WORKER_RUNTIME_BASE=dockerhub.timeweb.cloud/nvidia/cuda:12.2.0-runtime-ubuntu22.04
#IMAGE_WORKER_CUDA_DEVEL_BASE=dockerhub.timeweb.cloud/nvidia/cuda:12.2.0-devel-ubuntu22.04
#IMAGE_WORKER_CUDA_ARCH=86          # compute capability: 86 = RTX 30xx (Ampere)
#
# ID/имя бэкенда в балансере (должно быть стабильным: при смене host/port
# балансер отвечает 409 и запись не обновляется — удалите бэкенд в WebUI).
#SDWORKER_BACKEND_ID=imageworker

# ── REMOTE WORKERS: where the balancer lives ─────────────────────────────────
#
# REQUIRED for `--profile worker` (backends only, balancer on ANOTHER machine).
# Without it the workers try the in-network name "loadbalancer", which does not
# exist in that profile, and registration retries forever with an error in the log.
#
# BALANCER_URL is the ADMIN API (:18081), NOT the client port (:18080).
# It reaches all three consumers:
#   cppworker   -> CPPWORKER_BALANCER_URL
#   imageworker -> SDWORKER_BALANCER_URL
#   agent       -> BALANCER_URL (embedded agent included)
#
# Scenario 1 (everything on one box): leave commented out — the default
# http://loadbalancer:18081 is correct inside the compose network.
#
# Scenario 2 (this machine is a worker):
#BALANCER_URL=http://192.168.1.10:18081
#
# Per-service overrides, if the workers must reach DIFFERENT balancers:
#CPPWORKER_BALANCER_URL=http://192.168.1.10:18081
#SDWORKER_BALANCER_URL=http://192.168.1.10:18081
#
# Address of THIS machine as the balancer sees it (not localhost!). The balancer
# proxies inference to <advertise host>:18092 (text) and :18093 (images), so those
# ports must be reachable from the balancer host.
#BACKEND_HOST=192.168.1.20
#CPPWORKER_ADVERTISE_HOST=192.168.1.20
#SDWORKER_ADVERTISE_HOST=192.168.1.20
#
# Token the workers expect on their own protected endpoints. Must be THE SAME as
# on the balancer (single stack token).
#CPPWORKER_BALANCER_TOKEN=<same-as-CPPWORKER_API_TOKEN>
#SDWORKER_BALANCER_TOKEN=<same-as-CPPWORKER_API_TOKEN>
#
# UNIQUE IDs — REQUIRED when two or more worker machines share one balancer.
#
# The compose file is identical on every machine, so by default every field that
# identifies a backend is IDENTICAL too: host=cppworker-gpu (container name),
# agentId=cppworker-gpu-bundled-agent, cppWorkerPort=18092, imageworker for the
# image worker. The balancer cannot tell the machines apart and the second one
# would overwrite the first one's record (its CPU/GPU shown under the first
# machine's URL) while serving no traffic at all.
#
# Since 0.7.30 the balancer rejects such a registration with 409 and an explicit
# message instead of silently merging the records. Set these on EVERY worker
# machine except the first (values are examples, must be unique per machine):
#AGENT_ID=cppworker-34
#SDWORKER_BACKEND_ID=imageworker-34
#
# On a worker host the TEXT backend is registered by the AGENT (cppworker has
# CPPWORKER_REGISTER_DISABLE=true), so its backend ID is AGENT_ID — there is no
# CPPWORKER_REGISTER_NAME variable to set.
#
# The external `agent` container is NOT part of `--profile worker`; it exists only
# for Ollama backends (`--profile legacy-agent`). Do not run it on a worker host:
# two collectors on one backend make the metrics flap.
#
# ── EMBEDDED METRICS AGENT ───────────────────────────────────────────────────
#
# Every worker collects its own metrics IN ITS OWN PROCESS and registers under the
# SAME backend ID. No extra container is needed.
#
# Defaults (compose):
#   cppworker-gpu -> CPPWORKER_AGENT_EMBEDDED=on   (port CPPWORKER_AGENT_PORT=18034)
#   imageworker   -> IMAGE_WORKER_AGENT_EMBEDDED=on (port IMAGE_WORKER_AGENT_PORT=18033)
#
# The image worker used to default to `off` while cppworker defaulted to `on`.
# On a remote machine that produced a backend record with NO telemetry at all:
# hasAgent=false, agentPort=18032 (a foreign container's port) and
# gpuMemory/vramUsagePercent stuck at zeros — visible in the WebUI as
# "IMAGEWORKER-34: 0.0%, 0 MB / 1 MB". Both workers now default to `on`; you only
# need these lines to change the ports or to turn the embedded agent off.
#IMAGE_WORKER_AGENT_EMBEDDED=on
#IMAGE_WORKER_AGENT_PORT=18033
#CPPWORKER_AGENT_EMBEDDED=on
#CPPWORKER_AGENT_PORT=18034
#
# Turning an embedded agent OFF is only correct when an external `agent` container
# collects that backend's metrics instead — and never both at once.
