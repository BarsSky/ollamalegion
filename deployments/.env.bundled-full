# =============================================================================
# OllamaLegion bundled-full — defaults
# =============================================================================
# Используется в: docker-compose.bundled-full.yml
#
# Все значения по умолчанию подходят для production-ready запуска "из коробки".
# Единственное что ОБЯЗАТЕЛЬНО нужно сменить — CPPWORKER_API_TOKEN.
#
# Использование:
#   cd deployments
#   docker compose -f docker-compose.bundled-full.yml --env-file .env.bundled-full up -d --build
# Или:
#   .\scripts\start-bundled-full.ps1
# =============================================================================

# --- AUTH (ОБЯЗАТЕЛЬНО смените в production!) ----------------------------------
# Один и тот же токен используется балансером, cppworker-gpu, agent и WebUI.
# После изменения — пересобрать + перезапустить весь стек.
# Минимум 32 символа, base64-safe (без +, /, =).
CPPWORKER_API_TOKEN=changeme-bundled-full-token-min-32-chars-please

# --- LOAD BALANCER -------------------------------------------------------------
LB_PORT=18080              # Ollama API proxy (внешний)
LB_ADMIN_PORT=18081        # Admin API (internal, для agent/cppworker)
LB_LOG_LEVEL=info

# --- n_ctx reload (auto-adapt when prompt doesn't fit) ------------------------
LB_NCTX_RELOAD_ENABLED=true
LB_NCTX_RELOAD_MAX_N_CTX=131072
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
LB_NCTX_RELOAD_TIMEOUT_SEC=120

# --- AGENT → BALANCER адресация -------------------------------------------------
# ВАЖНО: внутри compose-сети используем DNS-имя сервиса loadbalancer,
# НЕ localhost. Иначе agent пытается достучаться до localhost внутри
# своего контейнера и получает connection refused.
BALANCER_URL=http://loadbalancer:18081

# --- CPPWORKER GPU --------------------------------------------------------------
# Внешний порт (хост → контейнер).
CPPWORKER_GPU_PORT=18092
# Тег образа (используется в image: ollama-legion/cppworker:gpu-<TAG>).
CPPWORKER_GPU_TAG=arch_all
# CUDA архитектура для сборки (all = все поддерживаемые, 86 = RTX 30xx, 89 = RTX 40xx).
CUDA_ARCH=all

# --- NVIDIA Container Toolkit (для GPU-доступа) --------------------------------
# NVIDIA_VISIBLE_DEVICES=all = все GPU на хосте доступны контейнеру.
# Для multi-GPU: 0,1 или UUIDs.
NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES выставлен в compose-файле жёстко (compute,utility).

# --- CPPWORKER параметры модели (defaults) -------------------------------------
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
CPPWORKER_GPU_LAYERS=20       # -1 = все слои на GPU
CPPWORKER_FLASH_ATTN_TYPE=-1   # -1 = autodetect, 0 = off, 1 = on
CPPWORKER_N_THREADS=0         # 0 = auto (физические ядра)
CPPWORKER_NUMA=false
CPPWORKER_USE_MMAP=true

# --- RAM fallback (cascade при нехватке VRAM) ----------------------------------
# 3-level cascade: VRAM → partial offload → CPU-only
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true

# --- Round 16 (2026-07-30): reasoning/thinking policy --------------------------
# Default = OFF (false). Для tool use workloads (Cline/Roo/Aider) держите OFF.
# Qwen3 thinking оборачивает tool call в <think> блоки, ломает tool call парсеры.
# Поставьте true если используете Coder/Qwen3-Coder и вам НЕ нужен tool use.
# Можно переопределить per-model через load-with-params.
#CPPWORKER_DEFAULT_ENABLE_REASONING=false
#CPPWORKER_DEFAULT_REASONING_BUDGET=0
#CPPWORKER_ENABLE_REASONING=false
#CPPWORKER_REASONING_BUDGET=0

# --- Round 15.1: Batched parallel inference (opt-in) ----------------------------
# ВНИМАНИЕ: для маленьких N (4-8) batched path СЕЙЧАС slower. Default = false.
# Включайте только если у вас 16+ параллельных запросов.
#CPPWORKER_ENABLE_BATCHED_PARALLEL=false

# --- AGENT intervals ------------------------------------------------------------
# Интервал сбора метрик (минимум 10). Слишком часто — нагружает CppWorker + nvidia-smi.
AGENT_COLLECT_INTERVAL=15
AGENT_HEARTBEAT_INTERVAL=30

# --- WEBUI ----------------------------------------------------------------------
WEBUI_PORT=18083
# WebUI version (показывается в sidebar). Можно переопределить через git rev-parse.
WEBUI_VERSION=dev
WEBUI_GIT_COMMIT=unknown
WEBUI_BUILD_DATE=unknown
