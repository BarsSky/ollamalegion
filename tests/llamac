// TestLlamaCppTransport_TagsWithFallback проверяет /api/tags через fallback /v1/models
func TestLlamaCppTransport_TagsWithFallback(t *testing.T) {
	worker := newMockCppWorkerOpenAI()
	defer worker.Close()

	proxy := createTestProxyForLlamaCppOpenAI(t, worker.server.URL)

	// НЕ регистрируем метрики — fallback должен сработать
	req := httptest.NewRequest("GET", "/api/tags", nil)
	rec := httptest.NewRecorder()

	proxy.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		body, _ := io.ReadAll(rec.Body)
		t.Fatalf("expected 200 OK, got %d: %s", rec.Code, string(body))
	}

	var tagsResp map[string]interface{}
	if err := json.NewDecoder(rec.Result().Body).Decode(&tagsResp); err != nil {
		t.Fatalf("failed to decode tags: %v", err)
	}

	models, ok := tagsResp["models"].([]interface{})
	if !ok {
		t.Fatalf("response missing 'models' array: %v", tagsResp)
	}

	if len(models) == 0 {
		t.Error("tags fallback returned 0 models — expected at least 1 from /v1/models")
	} else {
		firstModel := models[0].(map[string]interface{})
		t.Logf("✅ /api/tags fallback: %d models, first=%q", len(models), firstModel["name"])
	}
}

// TestLlamaCppTransport_NoStarsInResponse проверяет что ответы не "**"
func TestLlamaCppTransport_NoStarsInResponse(t *testing.T) {
	worker := newMockCppWorkerOpenAI()
	defer worker.Close()

	proxy := createTestProxyForLlamaCppOpenAI(t, worker.server.URL)
	registerModelOnProxy(proxy, "llamacpp-1", "test-model")

	checkResponse := func(t *testing.T, stream bool) {
		t.Helper()
		reqBody := map[string]interface{}{
			"model": "test-model",
			"messages": []map[string]string{
				{"role": "user", "content": "Привет!"},
			},
			"stream": stream,
		}
		bodyBytes, _ := json.Marshal(reqBody)
		req := httptest.NewRequest("POST", "/api/chat", bytes.NewReader(bodyBytes))
		req.Header.Set("Content-Type", "application/json")
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)

		if stream {
			scanner := bufio.NewScanner(rec.Result().Body)
			var allText strings.Builder
			for scanner.Scan() {
				var chunk map[string]interface{}
				if json.Unmarshal([]byte(scanner.Text()), &chunk) == nil {
					if msg, ok := chunk["message"].(map[string]interface{}); ok {
						if c, ok := msg["content"].(string); ok {
							allText.WriteString(c)
						}
					}
				}
			}
			if allText.String() == "**" {
				t.Error("streaming response is '**'")
			}
		} else {
			var respData map[string]interface{}
			json.NewDecoder(rec.Result().Body).Decode(&respData)
			msg, _ := respData["message"].(map[string]interface{})
			if msg != nil {
				content, _ := msg["content"].(string)
				if content == "**" {
					t.Error("non-streaming response is '**'")
				}
			}
		}
	}

	t.Run("non-streaming", func(t *testing.T) { checkResponse(t, false) })
	t.Run("streaming", func(t *testing.T) { checkResponse(t, true) })

	t.Log("✅ No '**' in any response")
}

// TestLlamaCppTransport_APIChain проверяет всю цепочку API взаимодействия:
// tags → chat (non-streaming) → chat (streaming) → generate → ps
func TestLlamaCppTransport_APIChain(t *testing.T) {
	worker := newMockCppWorkerOpenAI()
	defer worker.Close()

	proxy := createTestProxyForLlamaCppOpenAI(t, worker.server.URL)
	registerModelOnProxy(proxy, "llamacpp-1", "test-model")

	// 1. GET /api/tags
	t.Run("01_tags", func(t *testing.T) {
		req := httptest.NewRequest("GET", "/api/tags", nil)
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)
		if rec.Code != http.StatusOK {
			t.Fatalf("/api/tags returned %d", rec.Code)
		}
		var resp map[string]interface{}
		json.NewDecoder(rec.Result().Body).Decode(&resp)
		models, _ := resp["models"].([]interface{})
		if len(models) == 0 {
			t.Error("/api/tags returned 0 models")
		} else {
			t.Logf("✓ /api/tags: %d models", len(models))
		}
	})

	// 2. POST /api/chat non-streaming
	t.Run("02_chat_nonstreaming", func(t *testing.T) {
		reqBody, _ := json.Marshal(map[string]interface{}{
			"model": "test-model",
			"messages": []map[string]string{
				{"role": "user", "content": "Привет!"},
			},
			"stream": false,
		})
		req := httptest.NewRequest("POST", "/api/chat", bytes.NewReader(reqBody))
		req.Header.Set("Content-Type", "application/json")
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)

		if rec.Code != http.StatusOK {
			t.Fatalf("/api/chat returned %d", rec.Code)
		}

		var resp map[string]interface{}
		json.NewDecoder(rec.Result().Body).Decode(&resp)
		msg, _ := resp["message"].(map[string]interface{})
		content, _ := msg["content"].(string)
		if content == "" {
			t.Error("chat response content is empty")
		}
		t.Logf("✓ /api/chat (non-streaming): %q", content)
	})

	// 3. POST /api/chat streaming
	t.Run("03_chat_streaming", func(t *testing.T) {
		reqBody, _ := json.Marshal(map[string]interface{}{
			"model": "test-model",
			"messages": []map[string]string{
				{"role": "user", "content": "Привет!"},
			},
			"stream": true,
		})
		req := httptest.NewRequest("POST", "/api/chat", bytes.NewReader(reqBody))
		req.Header.Set("Content-Type", "application/json")
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)

		if rec.Code != http.StatusOK {
			t.Fatalf("/api/chat streaming returned %d", rec.Code)
		}

		scanner := bufio.NewScanner(rec.Result().Body)
		var doneFound bool
		var contentCollected strings.Builder
		for scanner.Scan() {
			var chunk map[string]interface{}
			if json.Unmarshal([]byte(scanner.Text()), &chunk) == nil {
				if done, _ := chunk["done"].(bool); done {
					doneFound = true
				}
				if msg, ok := chunk["message"].(map[string]interface{}); ok {
					if c, ok := msg["content"].(string); ok {
						contentCollected.WriteString(c)
					}
				}
			}
		}
		if !doneFound {
			t.Error("streaming missing done:true")
		}
		if contentCollected.Len() == 0 {
			t.Error("streaming collected no content")
		}
		t.Logf("✓ /api/chat (streaming): %q (done=%v)", contentCollected.String(), doneFound)
	})

	// 4. POST /api/generate non-streaming
	t.Run("04_generate", func(t *testing.T) {
		reqBody, _ := json.Marshal(map[string]interface{}{
			"model":  "test-model",
			"prompt": "Скажи привет",
			"stream": false,
		})
		req := httptest.NewRequest("POST", "/api/generate", bytes.NewReader(reqBody))
		req.Header.Set("Content-Type", "application/json")
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)

		if rec.Code != http.StatusOK {
			t.Fatalf("/api/generate returned %d", rec.Code)
		}

		var resp map[string]interface{}
		json.NewDecoder(rec.Result().Body).Decode(&resp)
		response, _ := resp["response"].(string)
		if response == "" {
			t.Error("generate response is empty")
		}
		t.Logf("✓ /api/generate: %q", response)
	})

	// 5. GET /api/ps
	t.Run("05_ps", func(t *testing.T) {
		req := httptest.NewRequest("GET", "/api/ps", nil)
		rec := httptest.NewRecorder()
		proxy.ServeHTTP(rec, req)

		if rec.Code != http.StatusOK {
			t.Fatalf("/api/ps returned %d", rec.Code)
		}
		var resp map[string]interface{}
		json.NewDecoder(rec.Result().Body).Decode(&resp)
		t.Logf("✓ /api/ps: %v", resp["models"])
	})

	// 6. GET /api/v1/gguf/backends
	t.Run("06_gguf_backends", func(t *testing.T) {
		state := proxy.GetClusterState()
		if state == nil {
			t.Fatal("cluster state is nil")
		}
		found := false
		for _, bm := range state.Backends {
			if bm.BackendType == types.BackendTypeLlamaCpp {
				found = true
				if len(bm.LlamaCpp.LoadedModels) == 0 {
					t.Error("llama.cpp backend has no loaded models")
				}
			}
		}
		if !found {
			t.Error("no llama.cpp backend in cluster state")
		}
		t.Logf("✓ /api/v1/gguf/backends: data present")
	})

	// Проверяем что все запросы дошли до mock
	reqs := atomic.LoadInt64(&worker.requests)
	t.Logf("✅ Full API chain: all 6 endpoints OK, %d requests to cppworker", reqs)
