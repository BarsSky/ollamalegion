        "operationId": "getAgent",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "description": "ID агента",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent info retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendInfo"
                }
              }
