{
  "backendEngine": "llama_cpp",
  "loadBalancer": {
    "host": "0.0.0.0",
    "port": 18080,
    "apiPort": 18081,
    "statePath": "data/state.json",
    "tlsHost": "",
    "tlsPort": 8443,
    "trustedProxies": [
      "127.0.0.1/8",
      "172.17.0.0/16",
      "172.18.0.0/16",
      "172.28.0.0/16",
      "10.0.0.0/8",
      "192.168.0.0/16"
    ],
    "clientIPHeaders": ["X-Forwarded-For", "X-Real-IP", "CF-Connecting-IP"]
  },
  "backends": [],
  "balancing": {
    "algorithm": "resource-aware",
    "modelAffinity": true,
    "sessionStickiness": true,
    "healthCheckInterval": 10,
    "metricsInterval": 5,
    "requestTimeout": 600,
    "firstByteTimeout": 600,
    "streamingIdleTimeout": 1800,
    "streamTimeout": 1800,
    "queueTimeout": 900,

    "queueMaxSize": 100,
    "queueWorkers": 4,
    "sessionTTL": 900,
    "prewarm": {
      "enabled": true,
      "triggerLoadThreshold": 0.70,
      "maxPrewarmPerCycle": 2,
      "checkIntervalSec": 10
    },
    "modelInstances": {
      "defaultMinInstances": 1,
      "defaultMaxInstances": 3,
      "idleUnloadAfter": "10m"
    },
    "scoring": {
      "modelAlreadyLoaded": 0.15,
      "modelLoadingCost": 0.10,
      "queueDepthPenalty": 0.05,
      "errorRatePenalty": 0.05,
      "predictionBonus": 0.10
    },
    "syncModelLoad": {
      "enabled": true,
      "timeout": "30s"
    },
    "resourceReservation": {
      "gpuHeadroomPercent": 15,
      "ramHeadroomPercent": 10
    },
    "useEnhancedScoring": true,
    "modelLoadTimeout": 120,
    "streamingMaxDuration": 0,
    "autoPull": {
      "enabled": true,
      "maxConcurrent": 2,
      "pullTimeout": "5m",
      "retryCount": 1
    },
    "modelReplication": {
      "enabled": false,
      "defaultMinInstances": 1,
      "defaultMaxInstances": 3,
      "idleUnloadAfter": "10m",
      "groups": []
    },
    "rpcCoordinator": {
      "enabled": false,
      "coordinatorURL": "",
      "workerPort": 18050,
      "timeout": "30s",
      "protocol": "http",
      "maxRetries": 3
    },
    "virtualModels": {
      "enabled": false,
      "models": []
    },
    "distInference": {
      "enabled": false,
      "grpcPort": 19000,
      "workers": []
    },
    "nctxReload": {
      "_note": "Auto-reload n_ctx when model's context is too small for request. Relies on cppworker RAM fallback if VRAM insufficient.",
      "auto_reload_n_ctx": true,
      "auto_reload_max_n_ctx": 131072,
      "auto_reload_vram_safety_factor": 0.85,
      "auto_reload_timeout_sec": 120
    }
  },

  "resources": {
    "gpu": {
      "maxUsagePercent": 90,
      "maxVramUsagePercent": 85,
      "maxTemperature": 85
    },
    "cpu": {
      "maxUsagePercent": 80
    },
    "memory": {
      "maxUsagePercent": 85
    },
    "disk": {
      "minFreeMB": 10240
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "api": {
    "rateLimit": 100,
    "rateBurst": 200
  },
  "tls": {
    "enabled": false,
    "certFile": "certs/server.crt",
    "keyFile": "certs/server.key",
    "minVersion": "TLS12",
    "autoCert": true
  },
  "auth": {
    "enabled": false,
    "tokens": [
      "changeme-bundled-with-agent-token-please-change"
    ],
    "headerName": "X-API-Token"
  },
  "defaultModelProfile": {
    "_note": "Phase D.3-fix fallback for clamping when per-model profile missing. contextLength=0 means no clamping — cppworker uses its own n_ctx or loaded model metrics.",
    "contextLength": 0,
    "batchSize": 512,
    "numGpuLayers": 30,
    "flashAttention": true,
    "useMmap": true
  }
}

