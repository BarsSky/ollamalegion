{
  "name": "ollamalegion",
  "version": "0.0.0",
  "private": true,
  "description": "OllamaLegion — visual regression tooling (Playwright). Installed only in dev; not required for runtime.",
  "scripts": {
    "test:visual": "playwright test --config=playwright.config.js",
    "test:visual:update": "playwright test --config=playwright.config.js --update-snapshots",
    "test:visual:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0"
  }
}