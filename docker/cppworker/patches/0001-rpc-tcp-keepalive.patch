+// The rpc server frees the buffers of a session only when recv on its socket
+// fails. If the peer vanishes without closing the connection (power loss,
+// unplugged cable), a half-open socket pins VRAM on the node for a long time.
+static bool set_keep_alive(sockfd_t sockfd) {
+    int flag = 1;
+    if (setsockopt(sockfd, SOL_SOCKET, SO_KEEPALIVE, (char *)&flag, sizeof(int)) != 0) {
+        return false;
+    }
+#ifdef _WIN32
+    tcp_keepalive ka = {};
+    ka.onoff             = 1;
+    ka.keepalivetime     = 60000;
+    ka.keepaliveinterval = 15000;
+    DWORD bytes_ret = 0;
+    return WSAIoctl(sockfd, SIO_KEEPALIVE_VALS, &ka, sizeof(ka), NULL, 0, &bytes_ret, NULL, NULL) == 0;
+#else
+    int idle     = 60;
+    int interval = 15;
+    int count    = 3;
+#  ifdef TCP_KEEPIDLE
+    if (setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle)) != 0) {
+        return false;
+    }
+#  endif
+#  ifdef TCP_KEEPALIVE
+    if (setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPALIVE, &idle, sizeof(idle)) != 0) {
+        return false;
+    }
+#  endif
+    if (setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPINTVL, &interval, sizeof(interval)) != 0) {
+        return false;
+    }
+    if (setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPCNT, &count, sizeof(count)) != 0) {
+        return false;
+    }
+    return true;
+#endif
+}
+
