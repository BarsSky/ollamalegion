{
  "loadBalancer": {
    "host": "0.0.0.0",
    "port": 18080,
    "apiPort": 18081,
    "statePath": "data/state.json",
    "trustedProxies": [
      "127.0.0.1/8",
      "172.17.0.0/16",
      "172.18.0.0/16",
      "172.28.0.0/16",
      "10.0.0.0/8",
      "192.168.0.0/16"
    ],
    "clientIPHeaders": ["X-Forwarded-For", "X-Real-IP", "CF-Connecting-IP"]
  },
  "backends": [
    {
      "id": "ollama-gpu-1",
      "name": "Ollama GPU Server 1",
      "host": "192.168.1.10",
      "ollamaPort": 11434,
      "agentPort": 18090,
      "weight": 10,
      "maxConcurrentRequests": 4,
      "maxModels": 8,
      "labels": ["gpu", "production"],
      "type": "ollama",
      "engine": "auto",
      "gpuMode": "gpu",
      "requestTimeout": 0
    },
    {
      "id": "llamacpp-gpu-1",
      "name": "llama.cpp GPU Server 1",
      "host": "192.168.1.20",
      "ollamaPort": 0,
      "agentPort": 18090,
      "weight": 10,
      "maxConcurrentRequests": 4,
      "maxModels": 4,
      "labels": ["gpu", "llamacpp"],
      "type": "llama_cpp",
      "engine": "auto",
      "gpuMode": "gpu",
      "cppWorkerPort": 18091,
      "cppWorkerConfig": {
        "grpcPort": 19000,
        "numGpuLayers": -1,
        "contextLength": 4096,
        "batchSize": 512,
        "flashAttention": true,
        "numa": false,
        "useMmap": true,
        "useMlock": false,
        "mainGpu": 0,
        "maxConcurrentReqs": 10,
        "strategy": "vram-ratio",
        "nThreads": 0,
        "ropeFreqBase": 10000.0,
        "ropeFreqScale": 1.0,
        "noKvOffload": false,
        "kvCacheType": "f16",
        "rmsNormEps": 0.00001,
        "ropeScalingType": "none",
        "ropeScalingFactor": 1.0,
        "yarnExtFactor": 1.0,
        "yarnAttnFactor": 1.0,
        "yarnBetaFast": 32.0,
        "yarnBetaSlow": 1.0,
        "noMemoryMap": false,
        "rpcBackend": "cuda"
      },
      "requestTimeout": 0
    }
  ],
  "balancing": {
    "algorithm": "resource-aware",
    "modelAffinity": true,
    "sessionStickiness": true,
    "healthCheckInterval": 10,
    "metricsInterval": 5,
    "requestTimeout": 120,
    "firstByteTimeout": 30,
    "streamingIdleTimeout": 120,
    "queueTimeout": 300,
    "queueMaxSize": 100,
    "queueWorkers": 4,
    "sessionTTL": 900,
    "useEnhancedScoring": true,
    "modelLoadTimeout": 120,
    "streamingMaxDuration": 0,
    "autoPull": {
      "enabled": true,
      "maxConcurrent": 2,
      "pullTimeout": "5m",
      "retryCount": 1
    },
    "prewarm": {
      "enabled": true,
      "triggerLoadThreshold": 0.70,
      "maxPrewarmPerCycle": 2,
      "checkIntervalSec": 10
    },
    "modelInstances": {
      "defaultMinInstances": 1,
      "defaultMaxInstances": 3,
      "idleUnloadAfter": "10m"
    },
    "modelReplication": {
      "enabled": false,
      "defaultMinInstances": 1,
      "defaultMaxInstances": 3,
      "idleUnloadAfter": "10m",
      "groups": []
    },
    "virtualModels": {
      "enabled": false,
      "models": []
    },
    "rpcCoordinator": {
      "enabled": false,
      "coordinatorURL": "http://localhost:18090",
      "workerPort": 18080,
      "timeout": "30s",
      "protocol": "http",
      "maxRetries": 3
    },
    "distInference": {
      "enabled": false,
      "grpcPort": 50051,
      "workers": []
    },
    "scoring": {
      "modelAlreadyLoaded": 0.15,
      "modelLoadingCost": 0.10,
      "queueDepthPenalty": 0.05,
      "errorRatePenalty": 0.05,
      "predictionBonus": 0.10
    },
    "syncModelLoad": {
      "enabled": true,
      "timeout": "30s"
    },
    "resourceReservation": {
      "gpuHeadroomPercent": 15,
      "ramHeadroomPercent": 10
    }
  },
  "resources": {
    "gpu": {
      "maxUsagePercent": 90,
      "maxVramUsagePercent": 85,
      "maxTemperature": 85
    },
    "cpu": {
      "maxUsagePercent": 80
    },
    "memory": {
      "maxUsagePercent": 85
    },
    "disk": {
      "minFreeMB": 10240
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "api": {
    "rateLimit": 100,
    "rateBurst": 200
  },
  "tls": {
    "enabled": false,
    "certFile": "certs/server.crt",
    "keyFile": "certs/server.key",
    "minVersion": "TLS12",
    "autoCert": true
  },
  "auth": {
    "enabled": false,
    "tokens": [
      "your-master-token-here-change-in-production"
    ],
    "headerName": "X-API-Token"
  },
  "initialized": false,
  "backendEngine": "llama_cpp"
}
