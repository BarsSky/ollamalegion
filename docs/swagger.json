{
  "openapi": "3.0.3",
  "info": {
    "title": "Ollama Load Balancer API",
    "description": "REST API для интеллектуального балансировщика нагрузки Ollama с мониторингом ресурсов GPU/CPU/RAM/Disk и умным распределением запросов.\n\n## Особенности\n- Умная балансировка на основе доступных ресурсов\n- Model Affinity - направление запросов к серверам с загруженной моделью\n- Real-time мониторинг через WebSocket\n- Health Check - автоматическое обнаружение нерабочих бэкендов\n- Session Stickiness - сохранение сессии на одном сервере\n- Queue Manager - обработка перегрузок с очередью запросов\n\n## Аутентификация\nAPI использует токены для аутентификации. Токен передается в заголовке `X-API-Token`.\nMaster token (первый в списке) может создавать и отзывать другие токены.",
    "version": "1.0.0",
    "contact": {
      "name": "Ollama Load Balancer"
    },
    "license": {
      "name": "MIT License"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local development server"
    },
    {
      "url": "https://localhost:8443",
      "description": "Production server (HTTPS)"
    },
    {
      "url": "http://{host}:{port}",
      "description": "Custom server",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "Hostname or IP address"
        },
        "port": {
          "default": "8081",
          "description": "API port"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "Cluster",
      "description": "Cluster status and information"
    },
    {
      "name": "Metrics",
      "description": "System and backend metrics"
    },
    {
      "name": "Backends",
      "description": "Backend management"
    },
    {
      "name": "Sessions",
      "description": "Session management"
    },
    {
      "name": "Models",
      "description": "Model information"
    },
    {
      "name": "Agents",
      "description": "Agent registration and metrics"
    },
    {
      "name": "Auth",
      "description": "Authentication and token management"
    },
    {
      "name": "Rate Limit",
      "description": "Rate limiter status"
    },
    {
      "name": "WebSocket",
      "description": "WebSocket endpoints for real-time data"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Проверка здоровья API. Не требует аутентификации.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cluster": {
      "get": {
        "tags": ["Cluster"],
        "summary": "Get cluster status",
        "description": "Получение информации о состоянии кластера",
        "operationId": "getClusterStatus",
        "responses": {
          "200": {
            "description": "Cluster status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
