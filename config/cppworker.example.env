# ============================================================
# CppWorker (llama.cpp) — Конфигурация через .env
# ============================================================
# Скопируйте этот файл в config/cppworker.env и отредактируйте
# под своё окружение. Файл читается контейнером при старте.
# Может быть изменён по сети через PUT /api/v1/cppworker/config
#
# Управление n_ctx на лету (per-model profiles):
#   Используйте API балансировщика, а не этот файл.
#   Подробнее: docs/cppworker-model-params.md
#   PUT    /api/v1/cppworker/model-profiles/{name}            — создать/обновить профиль
#   POST   /api/v1/cppworker/model-profiles/{name}/apply     — применить (reload)
#   Header X-Cpp-Ctx (от балансировщика) перебивает дефолт ниже.
#
# Допустимый диапазон contextLength: [256, 262144] (256K = нативный max gemma-4).
# ============================================================

# === Идентификация узла ===
NODE_NAME=llama-gpu-node-1

# === Сетевые параметры ===
LLAMA_HTTP_PORT=18091
LLAMA_GRPC_PORT=19000

# URL балансера для авторегистрации (API порт 18081)
# Для LAN: http://192.168.X.X:18081
# Для WAN: https://your-domain.com:18081 (с SSL через reverse proxy)
BALANCER_URL=http://localhost:18081

# === Пути к моделям ===
LLAMA_MODELS_DIR=/models

# === Таймауты ===
# WriteTimeout для HTTP streaming ответов (длительная генерация может превышать 5 минут).
# По умолчанию: 30m (30 минут). Установите 0 для отключения таймаута (не рекомендуется).
# Можно задать через флаг --write-timeout или переменную окружения CPPWORKER_WRITE_TIMEOUT.
# Примеры: 30m, 1h, 10m, 0
LLAMA_WRITE_TIMEOUT=30m

# === Параметры инференса llama.cpp ===
# Количество слоёв на GPU (-1 = все, 0 = CPU-only, N = конкретное число)
LLAMA_N_GPU_LAYERS=-1

# Размер контекста (токены)
LLAMA_CTX_SIZE=8192

# Размер батча
LLAMA_BATCH_SIZE=512

# Flash Attention (требует поддержки GPU архитектурой)
LLAMA_FLASH_ATTN=true

# NUMA оптимизация (для multi-socket CPU)
LLAMA_NUMA=false

# Memory mapping (рекомендуется для больших моделей)
LLAMA_MMAP=true

# Блокировка памяти (предотвращает swap, требует повышенных привилегий)
LLAMA_MLOCK=false

# Распределение тензоров по GPU (0 = равномерно)
# Пример для 2x RTX 4090 (24GB + 24GB): "24,24"
LLAMA_TENSOR_SPLIT=0

# Основной GPU (0-based индекс)
LLAMA_MAIN_GPU=0

# Количество CPU-потоков (0 = авто)
LLAMA_THREADS=0

# RoPE (Rotary Position Embedding) параметры (0 = значения по умолчанию)
LLAMA_ROPE_FREQ_BASE=0
LLAMA_ROPE_FREQ_SCALE=0

# Типы KV-кэша: f16, f32, q8_0, q4_0
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16

# RMS Norm epsilon (0 = default)
LLAMA_RMS_NORM_EPS=0

# === Управление моделями ===
# Автовыгрузка неиспользуемой модели через N времени (30m, 1h, 0 = отключено)
LLAMA_IDLE_UNLOAD=30m

# Принудительная репликация (для режима Model Replication)
LLAMA_ENFORCE_REPLICATION=false

# === Агент мониторинга ===
AGENT_ENABLED=true
AGENT_PORT=18032

# Интервал сбора метрик (секунды)
AGENT_COLLECT_INTERVAL=15

# Интервал heartbeat на балансер (секунды)
AGENT_HEARTBEAT_INTERVAL=30

# Таймаут запроса к агенту (секунды)
AGENT_TIMEOUT=10

# === Безопасность ===
# API токен для защищённых операций (оставьте пустым для отключения)
API_TOKEN=

# === RPC Worker (для External RPC Coordinator режима) ===
RPC_COORDINATOR_URL=
RPC_WORKER_PORT=18050

# === Дополнительные метки (через запятую key=value) ===
# Используются балансером для маршрутизации
NODE_LABELS=zone=lan