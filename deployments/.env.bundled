# =============================================================================
# Ollama Legion — bundled stack .env (cppworker-gpu + balancer + webui)
# =============================================================================
# Скопируйте в .env.bundled и при необходимости отредактируйте.
# Затем: docker compose -f docker-compose.cppworker-bundled.yml --env-file .env.bundled up -d --build
# =============================================================================

# ----- Порты на хосте -----
# Балансировщик: 18080 (OpenAI API) и 18081 (admin API)
LB_PORT=18080
LB_ADMIN_PORT=18081

# CppWorker (прямой доступ для отладки / обхода балансировщика)
CPPWORKER_GPU_PORT=18092

# WebUI
WEBUI_PORT=18083

# ----- API token -----
# Должен быть ОДИНАКОВЫМ в балансировщике и cppworker.
# В проде ОБЯЗАТЕЛЬНО смените на длинный случайный токен!
CPPWORKER_API_TOKEN=changeme-bundled-strong-token-please-change

# ----- Авторегистрация cppworker в балансировщике -----
# По умолчанию cppworker использует DNS-имя loadbalancer внутри Docker-сети:
#   CPPWORKER_BALANCER_URL=http://loadbalancer:18081
# Если балансировщик запущен вне этого compose (например, на хост-машине),
# задайте его IP/URL здесь. Если пусто — используется DNS-имя.
# Примеры:
#   BALANCER_URL=http://192.168.1.100:18081
#   BALANCER_URL=http://host.docker.internal:18081
BALANCER_URL=
# Рекламируемый host, под которым cppworker доступен из балансировщика.
# По умолчанию DNS-имя cppworker-gpu внутри compose-сети.
# Для IP-режима можно задать IP контейнера или хоста, но обычно достаточно
# DNS-имени. Если пусто — используется cppworker-gpu.
CPPWORKER_ADVERTISE_HOST=

# ----- Дефолтные параметры загрузки модели (cppworker) -----
# Эти значения используются cppworker при первом load модели
# (lazy load при первом запросе от клиента или ручной Load в WebUI).
# Можно переопределить через per-model profile в WebUI или через
# POST /api/models/load с явными параметрами.

# n_ctx по умолчанию (контекст модели в VRAM).
# Реальное значение при загрузке берётся из modelManagement.profiles
# в config.json балансировщика (например 8192 для gemma-4). Это значение
# используется как fallback если профиль не найден.
# Балансировщик динамически читает реальный n_ctx загруженной модели
# из метрик (Tier 3 в maxNumCtxForModel), поэтому clamping не жёсткий.
DEFAULT_CTX_SIZE=16384

# batch size
DEFAULT_BATCH_SIZE=512

# GPU layers: 20 = partial offload (рекомендуется для RTX 3070 8GB + 4-5GB модель)
#             -1 = все слои на GPU (нужно больше VRAM)
#              0 = CPU mode (медленно, но без VRAM)
DEFAULT_GPU_LAYERS=20

# Flash attention: -1=auto, 0=disabled, 1=enabled
DEFAULT_FLASH_ATTN_TYPE=-1

# CPU threads (0 = авто-определение)
DEFAULT_N_THREADS=0

# mmap (true = модель маппится в RAM через mmap, экономит RAM)
DEFAULT_USE_MMAP=true

# NUMA optimization
DEFAULT_NUMA=false

# ----- RAM fallback для n_ctx (когда VRAM недостаточна) -----
# Если true, cppworker при получении запроса с num_ctx > текущего загруженного
# n_ctx автоматически выгрузит модель и перезагрузит её с запрошенным n_ctx,
# используя mmap для размещения части модели/KV-cache в RAM.
# Это позволяет OpenWebUI работать с большим контекстом (например 16384)
# даже при занятой видеопамяти (5 из 8 ГБ), ценой снижения скорости.
CPPWORKER_RAM_FALLBACK_N_CTX=true

# Сколько GPU-слоёв оставить при RAM fallback:
#   -1 = оставить текущее значение DEFAULT_GPU_LAYERS
#    0 = CPU-only (гарантированно освобождает VRAM под KV-cache)
#   N  = явное число слоёв на GPU
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=0

# Максимальный n_ctx, до которого разрешён RAM fallback (защита от абсурдных значений).
# 16384 = достаточно для большинства chat-сценариев; увеличьте при необходимости.
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=16384

# ----- GPU -----
# all = все GPU; 0 = только первая; "0,1" = первые две
NVIDIA_VISIBLE_DEVICES=all

# Целевая архитектура CUDA для компиляции llama.cpp.
# Влияет на тэг собираемого образа cppworker-gpu:
#   "all" (по умолчанию) -> ollama-legion/cppworker:gpu-arch_all
#   "86"                 -> ollama-legion/cppworker:gpu-86
#   "75;86;89"           -> ollama-legion/cppworker:gpu-75-86-89
CUDA_ARCH=86
# Явное переопределение тэга образа gpu (опционально).
# Должно соответствовать CUDA_ARCH, иначе имя образа не совпадёт с ожидаемым.
CPPWORKER_GPU_TAG=86

# ----- Балансировщик (логирование) -----
LB_LOG_LEVEL=debug
