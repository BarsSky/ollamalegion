# =============================================================================
# OllamaLegion — окружение для docker-compose.cppworker-remote.yml
# (cppworker + agent, подключение к ВНЕШНЕМУ балансеру)
# =============================================================================
# Скопируйте в `.env` рядом с compose-файлом и заполните первые три значения.
# =============================================================================

# ─── ОБЯЗАТЕЛЬНО: куда подключаться ──────────────────────────────────────────
# ADMIN API балансера (порт 18081). НЕ 18080: 18080 — клиентский API,
# регистрация бэкендов и метрики идут в admin.
# Примеры:
#   другая машина в LAN:      http://192.168.1.10:18081
#   балансер на этом же хосте: http://host.docker.internal:18081
#   общая внешняя docker-сеть: http://loadbalancer:18081
BALANCER_URL=http://192.168.1.10:18081

# Тот же X-API-Token, что у балансера (в bundled-стеке — CPPWORKER_API_TOKEN).
BALANCER_TOKEN=changeme-bundled-with-agent-token

# Адрес ЭТОЙ машины, доступный С БАЛАНСЕРА. Именно его балансер получит как
# host бэкенда и будет по нему проксировать инференс.
# НЕ подходит имя compose-сервиса из этого файла (cppworker-gpu) — оно
# резолвится только внутри этой сети.
BACKEND_HOST=192.168.1.50

# ─── Образы ─────────────────────────────────────────────────────────────────
# Теги должны совпадать с тем, что раскатано на балансере (иначе рассинхрон
# протокола). Актуальные значения — в deployments/release-manifest.json.
CPPWORKER_GPU_TAG=gpu-r83-submodule-v22
AGENT_TAG=r83-submodule-v22

# ─── Модели и железо ────────────────────────────────────────────────────────
MODELS_DIR=./models
CPPWORKER_ADVERTISED_PORT=18092
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
# Сколько слоёв на GPU. Для 8 GB (RTX 3070) и 27B Q4 — 20; для 24 GB (A10) — 99.
CPPWORKER_GPU_LAYERS=20
CPPWORKER_FLASH_ATTN_TYPE=-1
CPPWORKER_USE_MMAP=true
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
# n_parallel воркера: столько параллельных запросов бэкенд примет.
# Должно совпадать с CPPWORKER_PARALLEL/n_parallel и влияет на распределение.
CPPWORKER_PARALLEL=1

# ─── Агент ──────────────────────────────────────────────────────────────────
AGENT_ID=cppworker-remote-agent
AGENT_PORT=18032
# Вместимость, которую агент сообщает балансеру (по умолчанию = CPPWORKER_PARALLEL).
AGENT_MAX_CONCURRENT_REQUESTS=1
AGENT_MAX_MODELS=4
AGENT_WEIGHT=1
NODE_LABELS=gpu,llamacpp
COLLECT_INTERVAL=10
HEARTBEAT_INTERVAL=15
AGENT_LOG_LEVEL=info

# ─── GPU ────────────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
