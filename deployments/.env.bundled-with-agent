# =============================================================================
# OllamaLegion bundled with sidecar agent — переменные окружения
# =============================================================================
# Используется в: docker-compose.cppworker-bundled-with-agent.yml
# Скопируйте в .env.bundled-with-agent и отредактируйте перед запуском.
#
#   cd deployments
#   cp .env.bundled-with-agent.example .env.bundled-with-agent
#   docker compose -f docker-compose.cppworker-bundled-with-agent.yml \
#     --env-file .env.bundled-with-agent up -d --build
# =============================================================================

# --- Loadbalancer --------------------------------------------------------------
LB_PORT=18080
LB_ADMIN_PORT=18081
LB_LOG_LEVEL=info

# --- Auth (ОБЯЗАТЕЛЬНО смените) ------------------------------------------------
# Один и тот же токен используется балансером, cppworker и agent'ом.
CPPWORKER_API_TOKEN=JH678MNSJNDAJNDSK

# --- n_ctx reload ---------------------------------------------------------------
LB_NCTX_RELOAD_ENABLED=true
LB_NCTX_RELOAD_MAX_N_CTX=131072
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
LB_NCTX_RELOAD_TIMEOUT_SEC=120

# --- Agent → Balancer адресация -------------------------------------------------
# 2026-06-30: BALANCER_URL должен указывать на DNS-имя сервиса loadbalancer внутри
# compose-сети (а не localhost), иначе agent пытается достучаться до localhost
# внутри своего контейнера и получает connection refused.
BALANCER_URL=http://loadbalancer:18081

# --- CppWorker GPU --------------------------------------------------------------
CPPWORKER_GPU_PORT=18092
CPPWORKER_GPU_TAG=86 #arch_all
CUDA_ARCH=86 #86

# --- NVIDIA Container Toolkit (для GPU-доступа) --------------------------------
# 2026-06-30: NVIDIA_VISIBLE_DEVICES обязательно для runtime: nvidia —
# без него NVIDIA Container Toolkit не монтирует /dev/nvidia* в контейнер.
NVIDIA_VISIBLE_DEVICES=all
# 2026-06-30: NVIDIA_DRIVER_CAPABILITIES выставлен в compose-файле жёстко
# (compute,utility) — env здесь не нужен, потому что compose приоритетнее.

# --- CppWorker параметры модели -------------------------------------------------
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
CPPWORKER_GPU_LAYERS=20
CPPWORKER_FLASH_ATTN_TYPE=-1
CPPWORKER_N_THREADS=0
CPPWORKER_NUMA=false
CPPWORKER_USE_MMAP=true

# --- RAM fallback (2026-06-25 cascade) -------------------------------------------
# При нехватке VRAM делает 3-уровневый каскад: VRAM → partial offload → CPU-only.
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true

# --- Round 16 (2026-07-30): reasoning/thinking policy --------------------------
# Default = OFF (false). Для tool use workloads (Cline/Roo/Aider) держите OFF:
# Qwen3 thinking оборачивает tool call в <think> блоки, ломает tool call парсеры.
# Per-model override через load-with-params {"enableReasoning": true} перебивает.
#CPPWORKER_DEFAULT_ENABLE_REASONING=false
#CPPWORKER_DEFAULT_REASONING_BUDGET=0
#CPPWORKER_ENABLE_REASONING=false
#CPPWORKER_REASONING_BUDGET=0

# --- Round 15.1: Batched parallel inference (opt-in) ----------------------------
# Включает true parallel llama_decode через BatchedScheduler. Default = false.
# ВНИМАНИЕ: для маленьких N (4-8) batched path СЕЙЧАС slower (functional
# baseline v0.5.0, lock serializes все сессии). Не включайте для low-load.
#CPPWORKER_ENABLE_BATCHED_PARALLEL=false

# --- Agent intervals ------------------------------------------------------------
# Интервал сбора метрик в секундах (минимум 10). Запускать слишком часто не
# нужно — это нагружает CppWorker и nvidia-smi.
AGENT_COLLECT_INTERVAL=15
AGENT_HEARTBEAT_INTERVAL=30

# --- WebUI ----------------------------------------------------------------------
WEBUI_PORT=18083

# --- De-dup v2 (2026-06-30) -----------------------------------------------------
# Координаты физического cppworker, который обёртывает agent. Эти env подставляются
# в AGENT_CPPWORKER_HOST/PORT в compose-файле и используются в register-payload
# агента как host/cppWorkerPort. Без этого de-dup по (host, port) в
# /api/v1/gguf/backends не срабатывает: agent регистрируется с host=имя-agent-контейнера,
# а cppworker — с host=cppworker-gpu (разные ключи → дубль в WebUI).
AGENT_CPPWORKER_HOST=cppworker-gpu
AGENT_CPPWORKER_PORT=18092

# --- NB ------------------------------------------------------------------------
# 2026-06-30: фикс «GPU не отображается в WebUI»
# Проблема была в том, что сервис `agent` в compose-файле НЕ имел:
#   runtime: nvidia
#   NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Без них NVIDIA Container Toolkit не монтировал в agent-контейнер:
#   /dev/nvidia0, /dev/nvidiactl, /dev/nvidia-uvm*
#   libnvidia-ml.so.1
# В результате nvml.Init() возвращал ERROR_LIBRARY_NOT_FOUND, nvidia-smi
# отсутствовал в PATH (нет в base-образе nvidia/cuda:12.2.0-base),
# /dev/nvidia0 не существовал → detectPlatformMode() возвращал ModeCPU.
#
# Фикс уже встроен в docker-compose.cppworker-bundled-with-agent.yml, ничего
# дополнительно выставлять не нужно — просто пересоберите образ agent'а
# (--build) при следующем `docker compose up`.

