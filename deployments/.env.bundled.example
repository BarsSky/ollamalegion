# =============================================================================
# Ollama Legion — bundled stack .env (cppworker-gpu + balancer + webui)
# =============================================================================
# Скопируйте в .env.bundled и при необходимости отредактируйте.
# Затем: docker compose -f docker-compose.cppworker-bundled.yml --env-file .env.bundled up -d --build
# =============================================================================

# ----- Порты на хосте -----
# Балансировщик: 18080 (OpenAI API) и 18081 (admin API)
LB_PORT=18080
LB_ADMIN_PORT=18081

# CppWorker (прямой доступ для отладки / обхода балансировщика)
CPPWORKER_GPU_PORT=18092

# WebUI
WEBUI_PORT=18083

# ----- API token -----
# Должен быть ОДИНАКОВЫМ в балансировщике и cppworker.
# В проде ОБЯЗАТЕЛЬНО смените на длинный случайный токен!
CPPWORKER_API_TOKEN=changeme-bundled-strong-token-please-change

# ----- Авторегистрация cppworker в балансировщике -----
# По умолчанию cppworker использует DNS-имя loadbalancer внутри Docker-сети:
#   CPPWORKER_BALANCER_URL=http://loadbalancer:18081
# Если балансировщик запущен вне этого compose (например, на хост-машине),
# задайте его IP/URL здесь. Если пусто — используется DNS-имя.
# Примеры:
#   BALANCER_URL=http://192.0.2.100:18081
#   BALANCER_URL=http://host.docker.internal:18081
BALANCER_URL=
# Рекламируемый host, под которым cppworker доступен из балансировщика.
# По умолчанию DNS-имя cppworker-gpu внутри compose-сети.
# Для IP-режима можно задать IP контейнера или хоста, но обычно достаточно
# DNS-имени. Если пусто — используется cppworker-gpu.
CPPWORKER_ADVERTISE_HOST=

# ----- Дефолтные параметры загрузки модели (cppworker) -----
# ЕДИНЫЙ ИСТОЧНИК ИСТИНЫ: config/cppworker-defaults.json
#   - cppworker читает его при старте (internal/cppbackend/config.go:LoadConfigFromEnv)
#   - WebUI (GGUF Models → Settings) читает/пишет через API PUT /api/v1/cppworker/config/update
#   - Изменения через WebUI сохраняются в JSON и применяются с auto-reload загруженных моделей
#
# Приоритет при старте cppworker:
#   1. CLI флаги (--ctx-size, --gpu-layers, ...) — высший приоритет
#   2. CPPWORKER_* env-переменные (ниже) — переопределяют JSON
#   3. config/cppworker-defaults.json — единый источник дефолтов
#   4. DefaultConfig() — хардкод-дефолты (если JSON отсутствует)
#
# ВАЖНО: значения ниже — ОВЕРРАЙДЫ поверх JSON. Если хотите изменить только
# один параметр, закомментируйте остальные (они не будут мешать JSON-дефолту).
# Рекомендуемый путь: редактируйте config/cppworker-defaults.json напрямую
# или через WebUI (GGUF Models → Settings → Save). Не дублируйте значения
# здесь и в JSON — это приводит к рассинхрону при разных путях инициализации.

# n_ctx по умолчанию (контекст модели в VRAM).
# 32768 — достаточно для длинных диалогов (system + history ~7000 токенов + user message)
# с запасом ~25000 токенов на ответ. Для 8GB VRAM cppworker может снизить n_ctx
# при загрузке (RAM fallback), если KV-кэш не помещается в остаток VRAM.
# Раскомментируйте и измените, если нужен override поверх JSON.
#CPPWORKER_CTX_SIZE=32768

# batch size (раскомментируйте для override)
#CPPWORKER_BATCH_SIZE=512

# GPU layers: 20 = partial offload (рекомендуется для 8GB VRAM + 4-5GB модель)
#             -1 = все слои на GPU (нужно больше VRAM)
#              0 = CPU mode (медленно, но без VRAM)
#CPPWORKER_GPU_LAYERS=20

# Flash attention: -1=auto, 0=disabled, 1=enabled
#CPPWORKER_FLASH_ATTN_TYPE=-1

# CPU threads (0 = авто-определение)
#CPPWORKER_N_THREADS=0

# mmap (true = модель маппится в RAM через mmap, экономит RAM)
#CPPWORKER_USE_MMAP=true

# NUMA optimization
#CPPWORKER_NUMA=false

# ----- RAM fallback для n_ctx (когда VRAM недостаточна) -----
# Если true, cppworker при получении запроса с num_ctx > текущего загруженного
# n_ctx автоматически выгрузит модель и перезагрузит её с запрошенным n_ctx,
# используя mmap для размещения части модели/KV-cache в RAM.
# Это позволяет OpenWebUI работать с большим контекстом (например 16384)
# даже при занятой видеопамяти (5 из 8 ГБ), ценой снижения скорости.
CPPWORKER_RAM_FALLBACK_N_CTX=true

# Сколько GPU-слоёв оставить при RAM fallback:
#   -1 = оставить текущее значение DEFAULT_GPU_LAYERS
#    0 = CPU-only (гарантированно освобождает VRAM под KV-cache)
#   -2 = AUTO-расчёт на основе modelSize, availableVRAM, requestedNCtx
#        (нужно CPPWORKER_AUTO_OFFLOAD=true). Для 19GB модели на A10
#        (24GB VRAM) + n_ctx=32K auto рассчитает ~10 GPU-слоёв.
#   N  = явное число слоёв на GPU
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2

# Максимальный n_ctx, до которого разрешён RAM fallback (защита от абсурдных значений).
# 16384 = достаточно для большинства chat-сценариев; 128000 = для Cline с большим контекстом.
# Зависит от доступной RAM на машине (KV-cache в RAM потребляет ~2MB на токен).
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000

# ----- Auto offload (расчёт gpu_layers на лету для 19GB+ моделей) -----
# При true: cppworker при загрузке модели проверяет размер .gguf файла и
# доступную VRAM. Если файл не влезает в VRAM (с safety 0.85), auto-рассчитывает
# число GPU-слоёв так, чтобы weights + KV-cache для requested_n_ctx поместились
# в VRAM. Используется совместно с CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2.
# Решает проблему: 19GB модель + n_ctx=32K на A10 (24GB) → OOM без auto.
CPPWORKER_AUTO_OFFLOAD=true

# ----- AutoTuneNCtx (автоподбор n_ctx + gpu_layers при RAM-fallback reload) -----
# При true: при RAM-fallback reload cppworker вычисляет максимальный n_ctx,
# который помещается в VRAM (с учётом partial offload через mmap в RAM).
# Стратегия:
#   1. Если requested_n_ctx помещается в VRAM с текущим gpu_layers → use as-is.
#   2. Иначе: уменьшаем gpu_layers (partial offload) для размещения в VRAM.
#   3. Если и с gpu_layers=0 не влезает → уменьшаем n_ctx до максимально
#      возможного (тогда inference пройдёт без кода 3 «prompt too long»).
# Решает проблему: «Cline прислал 53K prompt, требуется n_ctx=53K, VRAM=8GB» →
# cppworker перезагружает модель с gpu_layers=0 (через mmap в RAM) и
# n_ctx=максимально возможный (например 32K), чтобы inference прошёл.
# Дополнительно требует CPPWORKER_AUTO_OFFLOAD=true для авто-расчёта gpu_layers.
CPPWORKER_AUTO_TUNE_NCTX=true

# ----- Round 16 (2026-07-30): reasoning/thinking policy -----
# Default = OFF (false). Это важно для tool use workloads (Cline/Roo/Aider):
# Qwen3 thinking оборачивает tool call в <think> блоки, что ломает tool call
# парсеры (Cline tool_use парсер ищет JSON tool call напрямую, а получает
# <|im_start|>think + <think>... + </think> + tool_call). Включайте true
# только если:
#   - используете модель БЕЗ tool use (Coder/Qwen3-Coder reasoning-heavy)
#   - хотите видеть "thinking out loud" в WebUI (chain-of-thought визуализация)
# Per-model override: load-with-params {"enableReasoning": true} — перебивает
# эти defaults для конкретной модели.
#CPPWORKER_DEFAULT_ENABLE_REASONING=false
# 0 = no limit (default). Иначе max tokens for thinking (например 4096).
#CPPWORKER_DEFAULT_REASONING_BUDGET=0
# Legacy Config.EnableReasoning (для backward compat со старыми deployments
# которые стартовали только env-based, без JSON).
#CPPWORKER_ENABLE_REASONING=false
#CPPWORKER_REASONING_BUDGET=0

# ----- Round 15.1: Batched parallel inference (opt-in, default OFF) -----
# Включает true parallel llama_decode через BatchedScheduler для нескольких
# одновременных сессий. Требует parallel >= 2 в load-with-params.
# Default = false (Round 13 multi-slot path — backward compat).
# ВНИМАНИЕ: для маленьких N (4-8) batched path СЕЙЧАС slower (lock
# serializes все сессии через BatchedDecode) — это functional baseline
# v0.5.0, не production optimization. True speedup требует multiple model
# contexts или другого scheduling. Не включайте для low-load deployments.
#CPPWORKER_ENABLE_BATCHED_PARALLEL=false

# ----- GPU -----
# all = все GPU; 0 = только первая; "0,1" = первые две
NVIDIA_VISIBLE_DEVICES=all

# Целевая архитектура CUDA для компиляции llama.cpp.
# Влияет на тэг собираемого образа cppworker-gpu:
#   "all" (по умолчанию) -> ollama-legion/cppworker:gpu-arch_all
#   "86"                 -> ollama-legion/cppworker:gpu-86
#   "75;86;89"           -> ollama-legion/cppworker:gpu-75-86-89
CUDA_ARCH=86
# Явное переопределение тэга образа gpu (опционально).
# Должно соответствовать CUDA_ARCH, иначе имя образа не совпадёт с ожидаемым.
CPPWORKER_GPU_TAG=86

# ----- Verbose-логи cppworker для диагностики -----
# Включает подробные логи clamp/fallback/tool_calls/reload. Полезно при
# диагностике Cline/OpenWebUI сценариев (см. docs/tools-request-debug-runbook.md).
# После стабилизации можно выключить (false).
CPPWORKER_VERBOSE=true

# ----- n_ctx auto-reload на балансировщике -----
# Включает логику auto-reload: при получении ошибки ErrNCtxNeedsReload
# балансировщик пытается перезагрузить модель с бОльшим n_ctx.
# Требует CPPWORKER_RAM_FALLBACK_N_CTX=true на cppworker для fallback в RAM.
LB_NCTX_RELOAD_ENABLED=true
# 2026-06-24: синхронное ожидание reload в preflight (round-trip один, без EOF).
# Default true. false → fallback на async 503 + Retry-After: 5 (старое поведение).
LB_BALANCING_PREFLIGHT_SYNC_ENABLED=${LB_BALANCING_PREFLIGHT_SYNC_ENABLED:-true}
# 2026-06-25: повышен 32768 → 65536. Cline/OpenWebUI по умолчанию запрашивают
# n_ctx=65536 для gemma-4 с длинной историей + tools. Если reload попытается
# поднять n_ctx выше этого лимита, балансировщик возвращает HTTP 413 с
# actionable сообщением "reload manually via /api/profiles", что Cline
# интерпретирует как EOF и зацикливается на retry. Реальный VRAM-лимит
# всё равно контролируется через max_vram_n_ctx в cppworker runtime config
# и auto_reload_vram_safety_factor=0.95, поэтому 65536 безопасно.
# Для 8GB VRAM + gemma-4 8B используется auto_offload + auto_tune_nctx
# с partial GPU offload (gemma-4 профиль numCtx=131072 в config.bundled.json).
LB_NCTX_RELOAD_MAX_N_CTX=65536
# 2026-06-25: таймаут синхронного preflight reload повышен 60000 → 180000 (3 мин).
# Reload gemma-4 8B на 65K n_ctx через partial offload может занимать
# 90-150 сек (cold cache GPU, mmap в RAM, KV-cache alloc). 60 сек недостаточно,
# балансировщик прерывает polling и отдаёт клиенту EOF. 180 сек — max
# (см. PreflightSyncTimeoutMs Max=180000 в pkg/types/balancing.go).
LB_BALANCING_PREFLIGHT_SYNC_TIMEOUT_MS=${LB_BALANCING_PREFLIGHT_SYNC_TIMEOUT_MS:-180000}
# Safety 0.95 вместо 0.85 — для Gemma-4 (max_vram_n_ctx=40K, required=52K)
# при 0.85 reject'нули бы reload, при 0.95 влезает. Подробнее: docs/cppworker-model-params.md.
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
LB_NCTX_RELOAD_TIMEOUT_SEC=120

# ----- Стриминг: idle timeout между чанками -----
# Для 20GB GPU с большими моделями (>12B params, partial offload) idle между
# чанками может быть >120s. Default в cppworker'е и раньше — 120s → тихий обрыв.
# 600s = 10 мин — достаточно для "thinking"-моделей и burst-pause на 20GB GPU.
# При этом для маленьких моделей deadline продлевается после каждого чанка
# (через SetReadDeadline), реальное время ожидания значительно меньше.
# В WebUI/monitoring можно увидеть STREAMING_IDLE_TIMEOUT при реальном таймауте.
LB_STREAMING_IDLE_TIMEOUT_SEC=600

# ----- Балансировщик (логирование) -----
LB_LOG_LEVEL=debug
