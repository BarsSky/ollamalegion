# =============================================================================
# OllamaLegion bundled with sidecar agent — переменные окружения
# =============================================================================
# Используется в: docker-compose.cppworker-bundled-with-agent.yml
# Скопируйте в .env.bundled-with-agent и отредактируйте перед запуском.
#
#   cd deployments
#   cp .env.bundled-with-agent.example .env.bundled-with-agent
#   docker compose -f docker-compose.cppworker-bundled-with-agent.yml \
#     --env-file .env.bundled-with-agent up -d --build
# =============================================================================

# --- Loadbalancer --------------------------------------------------------------
LB_PORT=18080
LB_ADMIN_PORT=18081
LB_LOG_LEVEL=info

# --- Auth (ОБЯЗАТЕЛЬНО смените) ------------------------------------------------
# Один и тот же токен используется балансером, cppworker и agent'ом.
CPPWORKER_API_TOKEN=changeme-bundled-with-agent-token

# --- n_ctx reload (Round 32-35) ------------------------------------------------
LB_NCTX_RELOAD_ENABLED=true
LB_NCTX_RELOAD_MAX_N_CTX=131072
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
LB_NCTX_RELOAD_TIMEOUT_SEC=300
# Round 34 Phase 0 (2026-08-12): async reload — клиент сразу получает
# 503 + Retry-After, реальный reload идёт в background.
LB_NCTX_PREFLIGHT_ENABLED=true
LB_NCTX_PREFLIGHT_ASYNC_RELOAD=true
LB_NCTX_PREFLIGHT_ASYNC_RETRY_AFTER_SEC=30

# --- Agent → Balancer адресация -------------------------------------------------
# 2026-06-30: BALANCER_URL должен указывать на DNS-имя сервиса loadbalancer внутри
# compose-сети (а не localhost), иначе agent пытается достучаться до localhost
# внутри своего контейнера и получает connection refused.
BALANCER_URL=http://loadbalancer:18081

# --- CppWorker GPU --------------------------------------------------------------
CPPWORKER_GPU_PORT=18092
# Round 35 (2026-08-13): tag должен совпадать с тегом image в compose-файле
# (deployments/docker-compose.cppworker-bundled-with-agent.yml:84).
# Текущий r35: cgo SIGSEGV recover() + Round 34 follow-up. r34 — предыдущий
# (с mutex bug); r33 — Round 33 (413 fix); v3 — pre-31. Не забыть
# обновить .env после билда нового image.
CPPWORKER_GPU_TAG=86-abort-r35
CUDA_ARCH=all

# --- NVIDIA Container Toolkit (для GPU-доступа) --------------------------------
# 2026-06-30: NVIDIA_VISIBLE_DEVICES обязательно для runtime: nvidia —
# без него NVIDIA Container Toolkit не монтирует /dev/nvidia* в контейнер.
NVIDIA_VISIBLE_DEVICES=all
# 2026-06-30: NVIDIA_DRIVER_CAPABILITIES выставлен в compose-файле жёстко
# (compute,utility) — env здесь не нужен, потому что compose приоритетнее.

# --- CppWorker параметры модели -------------------------------------------------
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
CPPWORKER_GPU_LAYERS=20
CPPWORKER_FLASH_ATTN_TYPE=-1
CPPWORKER_N_THREADS=0
CPPWORKER_NUMA=false
CPPWORKER_USE_MMAP=true

# --- RAM fallback (2026-06-25 cascade) -------------------------------------------
# При нехватке VRAM делает 3-уровневый каскад: VRAM → partial offload → CPU-only.
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true

# --- Round 16 (2026-07-30): reasoning/thinking policy --------------------------
# Default = OFF (false). Для tool use workloads (Cline/Roo/Aider) держите OFF.
#CPPWORKER_DEFAULT_ENABLE_REASONING=false
#CPPWORKER_DEFAULT_REASONING_BUDGET=0
#CPPWORKER_ENABLE_REASONING=false
#CPPWORKER_REASONING_BUDGET=0

# --- Round 15.1: Batched parallel inference (opt-in) ----------------------------
# ВНИМАНИЕ: для маленьких N (4-8) batched path СЕЙЧАС slower. Default = false.
#CPPWORKER_ENABLE_BATCHED_PARALLEL=false

# --- Agent intervals ------------------------------------------------------------
# Интервал сбора метрик в секундах (минимум 10). Запускать слишком часто не
# нужно — это нагружает CppWorker и nvidia-smi.
AGENT_COLLECT_INTERVAL=15
AGENT_HEARTBEAT_INTERVAL=30

# --- WebUI ----------------------------------------------------------------------
WEBUI_PORT=18083

# --- De-dup v2 (2026-06-30) -----------------------------------------------------
# Координаты физического cppworker, который обёртывает agent. Эти env подставляются
# в AGENT_CPPWORKER_HOST/PORT в compose-файле и используются в register-payload
# агента как host/cppWorkerPort. Без этого de-dup по (host, port) в
# /api/v1/gguf/backends не срабатывает: agent регистрируется с host=имя-agent-контейнера,
# а cppworker — с host=cppworker-gpu (разные ключи → дубль в WebUI).
AGENT_CPPWORKER_HOST=cppworker-gpu
AGENT_CPPWORKER_PORT=18092

# --- NB ------------------------------------------------------------------------
# 2026-06-30: фикс «GPU не отображается в WebUI»
# Проблема была в том, что сервис `agent` в compose-файле НЕ имел:
#   runtime: nvidia
#   NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Без них NVIDIA Container Toolkit не монтировал в agent-контейнер:
#   /dev/nvidia0, /dev/nvidiactl, /dev/nvidia-uvm*
#   libnvidia-ml.so.1
# В результате nvml.Init() возвращал ERROR_LIBRARY_NOT_FOUND, nvidia-smi
# отсутствовал в PATH (нет в base-образе nvidia/cuda:12.2.0-base),
# /dev/nvidia0 не существовал → detectPlatformMode() возвращал ModeCPU.
#
# Фикс уже встроен в docker-compose.cppworker-bundled-with-agent.yml, ничего
# дополнительно выставлять не нужно — просто пересоберите образ agent'а
# (--build) при следующем `docker compose up`.

# 2026-06-30 (de-dup v2): фикс «два бэкенда на странице GGUF + мигание»
# Проблема:
#   1. Agent регистрировался с host=имя-agent-контейнера, port=18091 (legacy fallback
#      из extractCppWorkerPort). cppworker — с host=cppworker-gpu, port=18092. Ключи
#      де-дупа разные → WebUI показывал два бэкенда.
#   2. Health-check после регистрации ВСЕГДА делал GET /api/tags (Ollama API), у
#      agent-бэкенда нет Ollama на 11434 → connection refused → бэкенд unhealthy
#      → пропадал из GGUF → по heartbeat появлялся → «мигал» каждые ~30 сек.
# Фикс (уже встроен):
#   1. Agent шлёт в register() координаты ФИЗИЧЕСКОГО cppworker
#      (AGENT_CPPWORKER_HOST/PORT). De-dup корректно склеивает.
#   2. Health-check в api/handlers_agents.go для llama_cpp проверяет cppworker /health
#      (а не Ollama /api/tags). Бэкенд стабильно Healthy.
# Что нужно сделать:
#   - Пересобрать образы agent'а и балансера (--build).
#   - Никаких изменений в .env не требуется (значения по умолчанию в compose-файле).

# =============================================================================
# Round 35 (2026-08-13) — bundled-with-agent r35
# =============================================================================
# Round 35 закрывает crash-loop "Cline 65K → balancer preflight → cppworker
# SIGSEGV". Три связанных бага, все исправлены в cppworker image r35.
#
# 1. Reload→Load fallback (nctx_reload_handlers.go:786 + nctx_reload.go:765-825)
#    — preflight triggers /api/models/load (идемпотентный) вместо
#    /api/models/reload (который 404'ит для не-loaded модели). Теперь
#    после restart cppworker первый Cline 65K → load (а не reload→404→loop).
#    Задаётся через LB_NCTX_PREFLIGHT_* env vars выше.
#
# 2. C++ chat template cgo SIGSEGV recover (handlers_chat.go:281-310)
#    — C++ common_chat_templates_apply периодически SIGSEGV'ит в cgo
#    execution → exit code 2 → crash-loop. SIGSEGV-в-cgo catchable
#    через defer recover() в том же goroutine. Recover() ловит
#    panic → fallback на стабильный C API (llama_chat_apply_template).
#    Не требует env override.
#
# 3. IdleUnloadManager SIGSEGV guard (model_manager.go:538-549)
#    — checkAndUnload падал в bridge_free_model если LastUsedAt.IsZero().
#    now.Sub(zeroTime) = 631 трлн наносекунд → unload сразу →
#    use-after-free. Fix: IsZero() guard ПЕРЕД Sub(). Также
#    config/cppworker-defaults.json idleUnloadMinutes: 120 → 0
#    (off по дефолту; client keep_alive достаточно для bundled use case).
#
# 4. Cppworker image tag: CPPWORKER_GPU_TAG=86-abort-r35
#    — обновить в .env после каждого билда нового image. Текущий r35
#    работает стабильно (26+ мин uptime без SIGSEGV после deploy).
#
# 5. Деплой gotcha: compose auto-loads .env (без суффикса). Если есть
#    .env.bundled-with-agent — compose ИГНОРИРУЕТ его без --env-file.
#    Поддерживайте оба файла в синке, ИЛИ используйте --env-file
#    явно. Альтернатива: .env (default) уже сконфигурирован для r35
#    и auto-loaded compose'ом.
# =============================================================================
