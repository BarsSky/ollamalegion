# =============================================================================
# OllamaLegion bundled with sidecar agent — ЕДИНЫЙ ИСТОЧНИК ПРАВДЫ
# =============================================================================
# Это ЕДИНСТВЕННЫЙ файл, который нужно редактировать для настройки всех
# 4 контейнеров стека: balancer, cppworker-gpu, agent, webui.
#
# compose file (docker-compose.cppworker-bundled-with-agent.yml) читает
# ВСЕ значения ТОЛЬКО отсюда через ${VAR} (без hardcoded defaults в
# compose — defaults перенесены сюда). config/cppworker-defaults.json
# и config/config.bundled.json синхронизированы с этими значениями.
#
# Использование:
#   cd deployments
#   cp .env.bundled-with-agent.example .env.bundled-with-agent
#   $EDITOR .env.bundled-with-agent      # ← поменяй токен + значения
#   docker compose -f docker-compose.cppworker-bundled-with-agent.yml \
#                  --env-file .env.bundled-with-agent up -d --no-build
#
# ⚠️ ВАЖНО: compose auto-loads ТОЛЬКО .env (без суффикса). Если есть и
# .env и .env.bundled-with-agent — используй --env-file явно (см. выше),
# иначе compose возьмёт значения из .env (игнорируя .env.bundled-with-agent).
# Рекомендация: используй ОДИН файл .env.bundled-with-agent + --env-file.
# =============================================================================

# =============================================================================
# 1. AUTH (ОБЯЗАТЕЛЬНО смените на production!)
# =============================================================================
# Один и тот же токен используется балансером, cppworker, agent'ом и webui.
# Default = "changeme-bundled-with-agent-token" (dev only).
CPPWORKER_API_TOKEN=changeme-bundled-with-agent-token

# =============================================================================
# 2. BALANCER — порты и логи
# =============================================================================
LB_PORT=18080
LB_ADMIN_PORT=18081
LB_LOG_LEVEL=info

# =============================================================================
# 3. BALANCER — n_ctx reload (Round 32-35)
# =============================================================================
# Preflight n_ctx check для OpenAI/Ollama путей. Если загруженная модель
# имеет ctx меньше чем требует client → trigger async reload (503+Retry-After).
LB_NCTX_RELOAD_ENABLED=true
LB_NCTX_RELOAD_MAX_N_CTX=131072
LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95
# Round 35 (2026-08-13): синхронизировано с compose default.
# Round 32 (было 120s) → Round 35 (300s). 5GB модель на RTX 3070 загружается
# 80-90 сек; 30GB MoE — 3-5 минут. 300s даёт headroom.
LB_NCTX_RELOAD_TIMEOUT_SEC=300
# Round 34 follow-up: preflight должен быть ENABLED для async reload.
# Без LB_NCTX_PREFLIGHT_ENABLED=true preflight short-circuits → Cline 65K
# получает 413 sync вместо 503+Retry-After.
LB_NCTX_PREFLIGHT_ENABLED=true
# Round 31 #2: async reload — клиент сразу получает 503+Retry-After,
# реальный reload идёт в background. Cline/OpenWebUI retry'ят.
LB_NCTX_PREFLIGHT_ASYNC_RELOAD=true
# Round 35: 5 → 30 сек. Cline по дефолту retry'ит через 1 сек и долбит
# балансер; 30s даёт время на load (5-90 сек).
LB_NCTX_PREFLIGHT_ASYNC_RETRY_AFTER_SEC=30
# Round 35c (2026-08-13): polling timeout tuning для async load (cppworker
# вернул 202 Accepted, balancer опрашивает /api/models пока state != "loaded").
# Default 900s (15 min) cap + 2x multiplier покрывает A10 с 22GB Qwen3.6
# (est ~3min, 2*3+60=7.2min).
#
# Для медленных GPU / 70B+ моделей поднимите:
#   LB_NCTX_PREFLIGHT_MAX_WAIT_SEC=1800   # 30 min (3070 22GB MoE, 12-15min load)
#   LB_NCTX_PREFLIGHT_WAIT_MULTIPLIER=4   # 22GB Qwen3.6 (CUDA_Host alloc 5-10 min)
#   LB_NCTX_PREFLIGHT_WAIT_BUFFER_SEC=120 # дополнительный buffer
#
# Hard cap = 3600s (1 hour) для защиты от зависших загрузок.
LB_NCTX_PREFLIGHT_MAX_WAIT_SEC=900
LB_NCTX_PREFLIGHT_WAIT_MULTIPLIER=2
LB_NCTX_PREFLIGHT_WAIT_BUFFER_SEC=60

# =============================================================================
# 4. BALANCER — streaming timeouts (для OpenAI compat)
# =============================================================================
# ⚠️ Эти значения живут в config/config.json (bind-mounted), НЕ в env.
# compose их НЕ inject'ит. Если хотите переопределить — edit
# config/config.json (см. docs/deployment.md).
# Default values в config/config.bundled.json:
#   "requestTimeout": 600          # 10 мин
#   "firstByteTimeout": 600        # 10 мин до первого байта
#   "streamingIdleTimeout": 1800   # 30 мин между chunks в stream
#   "streamTimeout": 1800          # 30 мин общий timeout
#   "queueTimeout": 900            # 15 мин в очереди
#   "modelLoadTimeout": 120        # 2 мин на load
#
# R58.1 (2026-09-03): ENV override для ОТКЛЮЧЕНИЯ всех streaming-таймаутов.
# LB_STREAMING_NEVER_TIMEOUT=1 → balancer НЕ обрывает streaming по таймауту.
# Соединение живёт пока клиент не отменит (r.Context().Done()) или backend
# не закроет. Полезно для long-running inference (Qwen3.6-35B prefill
# 10+ мин) или когда клиент сам управляет cancel через ctx.
# Accepts: "1", "true", "yes" (case-insensitive). "0"/unset = defaults.
#LB_STREAMING_NEVER_TIMEOUT=1

# R60.18 F1 (2026-09-08): ENV override для break-glass настройки
# streamingIdleTimeout (timeout между chunks). НЕ общий stream timeout —
# только idle detection. Используется для incident response, когда
# нужно ускорить fail-fast на hang'ах (например, установить 60s чтобы
# быстрее замечать зависший cppworker). По симметрии с R60.17:
# env override BEATS per-model profile.
#LB_STREAMING_IDLE_TIMEOUT_SEC=60

# R60.18 F3 (2026-09-08): REMOVED LB_LLAMACPP_STREAM_TIMEOUT_SEC.
# Total stream timeout — wrong abstraction для LLM streaming
# (длина ответа фундаментально непредсказуема). Используйте
# streamingIdleTimeout (hang detection) + firstByteTimeout (prefill hang)
# + n_predict per-model profile (длина ответа). Подробнее:
# docs/R60.18-env-flags-audit.md

# =============================================================================
# 5. CPPWORKER — GPU image и CUDA
# =============================================================================
CPPWORKER_GPU_PORT=18092
# Round 35 (2026-08-13): tag image. Менять после каждого билда нового image.
# Current: r35 = cgo SIGSEGV recover() + Round 34 follow-up.
# History: r34 (mutex fix), r33 (413 fix), v3 (pre-31, old).
CPPWORKER_GPU_TAG=86-r60.16-bom-types
# CUDA_ARCH: sm_86 (RTX 30xx, 8GB; NVIDIA A10 24GB), sm_89 (RTX 40xx),
#           sm_90 (H100 80GB), sm_120 (Blackwell: A100/B100/B200, RTX 50xx).
#           Должно совпадать с твоим GPU.
# "all" — для multi-arch build, не для конкретной машины.
#
# Round 35c fix (2026-08-13): A10 = sm_86 (Ampere GA102, та же arch что и RTX 3070),
# НЕ sm_120 (Blackwell). Image `gpu-86-abort-r35` подходит для A10 БЕЗ пересборки.
# Для H100/A100/B100/RTX 50xx — менять CUDA_ARCH + tag + rebuild.
CUDA_ARCH=86
NVIDIA_VISIBLE_DEVICES=all

# =============================================================================
# 6. CPPWORKER — параметры модели
# =============================================================================
# R58.2 (2026-09-03): готовые hardware presets в config/hardware-presets/.
# Вместо ручной настройки значений ниже — запустите:
#   python scripts/apply-hardware-preset.py rtx30-8gb    # RTX 3050/3060/3070/3080 8GB
#   python scripts/apply-hardware-preset.py rtx40-24gb   # RTX 4080/4090 16-24GB
#   python scripts/apply-hardware-preset.py a10-24gb     # NVIDIA A10/A10G 24GB
#   python scripts/apply-hardware-preset.py rtx50-32gb   # RTX 5090 32GB (требует rebuild)
# Затем скопируйте KEY=VALUE в этот файл (или eval в shell).
# Документация: docs/ru/hardware-presets.md

# Defaults ниже — для RTX 30xx 8GB. Override через preset или вручную.
CPPWORKER_CTX_SIZE=32768
CPPWORKER_BATCH_SIZE=512
CPPWORKER_GPU_LAYERS=20
CPPWORKER_FLASH_ATTN_TYPE=-1
CPPWORKER_N_THREADS=0
CPPWORKER_NUMA=false
CPPWORKER_USE_MMAP=true

# =============================================================================
# 7. CPPWORKER — RAM fallback cascade
# =============================================================================
# При нехватке VRAM делает 3-уровневый каскад: VRAM → partial offload → CPU-only.
CPPWORKER_RAM_FALLBACK_N_CTX=true
CPPWORKER_RAM_FALLBACK_GPU_LAYERS=-2
CPPWORKER_RAM_FALLBACK_MAX_N_CTX=128000
CPPWORKER_AUTO_OFFLOAD=true
CPPWORKER_AUTO_TUNE_NCTX=true

# =============================================================================
# 8. CPPWORKER — reasoning/thinking policy (Round 16+)
# =============================================================================
# ⚠️ ВАЖНО для tool use workloads (Cline/Roo/Aider): оставьте FALSE.
# Qwen3-thinking и gemma-4 оборачивают tool calls в <think> блоки,
# ломает tool call парсеры. Поставьте TRUE только если:
#   - используете Coder/Qwen3-Coder
#   - вам НЕ нужен tool use
#   - хотите видеть reasoning в отдельном `reasoning_content` поле
# Per-model override: PUT /api/v1/cppworker/model-profiles/{name}
# (disable/enable per model без правки env).
CPPWORKER_DEFAULT_ENABLE_REASONING=false
CPPWORKER_DEFAULT_REASONING_BUDGET=0
CPPWORKER_ENABLE_REASONING=false
CPPWORKER_REASONING_BUDGET=0

# =============================================================================
# 9. CPPWORKER — Batched parallel inference (opt-in)
# =============================================================================
# Round 15.1: true parallel llama_decode через BatchedScheduler.
# ⚠️ Для маленьких N (4-8) batched path СЕЙЧАС slower. Default = false.
CPPWORKER_ENABLE_BATCHED_PARALLEL=false

# =============================================================================
# 10. CPPWORKER — IdleUnloadManager (Round 35)
# =============================================================================
# Default 0 = OFF. Модель держится в VRAM пока явно unload не вызван.
# client keep_alive (= "5m" → lastUsedAt += 5 мин) достаточно для bundled.
# Если нужно idle unload (auto-evict при простое), установите ≥ 60.
#CPPWORKER_IDLE_UNLOAD_MINUTES=0

# =============================================================================
# 11. AGENT — sidecar-сборщик метрик
# =============================================================================
AGENT_COLLECT_INTERVAL=15
AGENT_HEARTBEAT_INTERVAL=30
# De-dup v2 (2026-06-30): координаты физического cppworker для de-dup
# в /api/v1/gguf/backends. Без этого WebUI показывает 2 бэкенда
# (один от cppworker, один от agent).
AGENT_CPPWORKER_HOST=cppworker-gpu
AGENT_CPPWORKER_PORT=18092

# =============================================================================
# 12. AGENT → Balancer адресация
# =============================================================================
# Должен указывать на DNS-имя сервиса loadbalancer ВНУТРИ compose-сети
# (не localhost). Иначе agent → connection refused (localhost = сам agent).
BALANCER_URL=http://loadbalancer:18081

# =============================================================================
# 13. WEBUI
# =============================================================================
WEBUI_PORT=18083
# Version display in footer (Sprint 30+).
# Можно переопределить при `docker build --build-arg VERSION=...`
WEBUI_VERSION=dev
WEBUI_GIT_COMMIT=unknown
WEBUI_BUILD_DATE=unknown

# =============================================================================
# === ROUND 35 (2026-08-13) NOTES ===
# =============================================================================
# Round 35 закрывает crash-loop "Cline 65K → balancer preflight → cppworker
# SIGSEGV". 3 связанных бага, все исправлены в cppworker image r35.
#
# 1. Reload→Load fallback (nctx_reload_handlers.go:786 + nctx_reload.go:765-825)
#    — async reload triggers /api/models/load (idempotent) вместо
#    /api/models/reload (который 404 для не-loaded модели). Теперь после
#    restart cppworker первый Cline 65K → load (а не reload→404→loop).
#    Управляется через LB_NCTX_PREFLIGHT_* env vars выше.
#
# 2. C++ chat template cgo SIGSEGV recover (handlers_chat.go:281-310)
#    — C++ common_chat_templates_apply периодически SIGSEGV'ит в cgo
#    execution → exit code 2 → crash-loop. SIGSEGV-в-cgo catchable
#    через defer recover() в том же goroutine. Recover() ловит panic →
#    fallback на стабильный C API (llama_chat_apply_template).
#    Не требует env override.
#
# 3. IdleUnloadManager SIGSEGV guard (model_manager.go:538-549)
#    — checkAndUnload падал в bridge_free_model если LastUsedAt.IsZero().
#    Fix: IsZero() guard ПЕРЕД Sub(). config/cppworker-defaults.json
#    idleUnloadMinutes: 120 → 0 (off по дефолту; client keep_alive достаточно).
#
# 4. Cppworker image tag: CPPWORKER_GPU_TAG=86-r60.16-bom-types
#    — обновить в .env после каждого билда нового image. Текущий r35
#    работает стабильно (26+ мин uptime без SIGSEGV после deploy).
#
# 5. Deploy gotcha: compose auto-loads .env (без суффикса). Если есть
#    .env.bundled-with-agent — compose ИГНОРИРУЕТ его без --env-file.
# Поддерживайте оба файла в синке, ИЛИ используйте --env-file явно.
#
# 6. Round 35c (2026-08-13): polling timeout tuning для async load.
#    User report: 22GB Qwen3.6-35B-A3B на 3070 получил 8m7s timeout
#    (cppworker estimation 3.5min × 2 + 60s = 8m), но реальная загрузка
#    12+ min из-за CUDA_Host pinned memory alloc для 19GB+ весов.
#    LB_NCTX_PREFLIGHT_MAX_WAIT_SEC / _WAIT_MULTIPLIER / _WAIT_BUFFER_SEC
#    теперь env-конфигурируемые (cap 3600s, multiplier [1,6], buffer [0,600]).
#    Для 22GB+ Qwen3.6 на 3070: MAX_WAIT=1800, MULT=4, BUFFER=120.
#    Для A10 22GB Qwen3.6 (full GPU offload): defaults хватают.
# =============================================================================

# =============================================================================
# === DEPLOY TO A10 (sm_86, 24GB VRAM) ===
# =============================================================================
# IMPORTANT (Round 35c fix, 2026-08-13): NVIDIA A10 = sm_86 (compute capability
# 8.6), та же архитектура Ampere что и RTX 3070 (sm_86). Текущий image
# `gpu-86-abort-r35` подходит БЕЗ пересборки. (Ранее в notes была ошибка
# про sm_120 — A10 это НЕ Blackwell, это Ampere / GA102.)
#
# Verified live 2026-08-13: gemma-4 + qwen3 работают стабильно на 3070 (sm_86)
# через r35 image. На A10 (24GB VRAM, тот же sm_86) можно использовать
# ТОТ ЖЕ image:
#
# 1. Скопировать проект на A10 (git clone или rsync)
#
# 2. Создать .env:
#    cd deployments
#    cp .env.bundled-with-agent.example .env.bundled-with-agent
#    $EDITOR .env.bundled-with-agent   # ОБЯЗАТЕЛЬНО:
#      - CPPWORKER_API_TOKEN=<your-secret-token>
#      - CUDA_ARCH=86              # sm_86 для A10 (ТА ЖЕ что у 3070)
#      - CPPWORKER_GPU_TAG=86-r60.16-bom-types   # можно использовать готовый image
#      - LB_NCTX_RELOAD_VRAM_SAFETY_FACTOR=0.95  # 24GB VRAM, можно оставить 0.95
#
# 3. Опционально: пересобрать cppworker (НЕ обязательно, готовый image работает):
#    # Если хочешь с нуля, чтобы ccache кэш заполнился:
#    $env:DOCKER_BUILDKIT=1
#    $env:CUDA_ARCH=86
#    docker build -t ollama-legion/cppworker:86-abort-r35-local `
#                   -f docker/cppworker/Dockerfile.gpu .
#    # ~12-18 минут CUDA build (ccache прогревается)
#
# 4. Запустить стек:
#    docker compose -f docker-compose.cppworker-bundled-with-agent.yml `
#                   --env-file .env.bundled-with-agent `
#                   up -d --no-build
#
# 5. Скопировать .gguf модели в /opt/ollama-legion/models/ (или смонтировать
#    bind-mount в compose):
#    scp -r models/* user@a10:/opt/ollama-legion/models/
#
# 6. Проверить:
#    curl -s http://a10-host:18081/api/v1/backends
#    # Должно показать 1 healthy backend (cppworker-gpu-bundled-agent)
#
# 7. Smoke test:
#    curl -X POST http://a10-host:18080/v1/chat/completions \
#         -H "Content-Type: application/json" \
#         -H "Authorization: Bearer $CPPWORKER_API_TOKEN" \
#         -d '{"model":"gemma-4-E4B-it-Q4_K_M","messages":[{"role":"user","content":"hi"}]}'
#    # Должно вернуть {"choices":[{"message":{"content":"..."}}]}
#
# Если на A10 что-то крашится (что было при первой попытке пользователя):
#   - проверь версию NVIDIA driver: `nvidia-smi` (нужен >= 535 для CUDA 12.2)
#   - проверь CUDA runtime: `nvidia-smi --query-gpu=driver_version --format=csv`
#   - посмотри cppworker logs: `docker logs ol-bundled-cppworker-gpu --tail 100`
#   - увеличь `LB_NCTX_PREFLIGHT_MAX_WAIT_SEC=1800` (22GB Qwen3.6 на 24GB
#     VRAM загружается ~3-5 мин, fits в 15 мин default, но safety margin)
#   - с 24GB VRAM можно поднять `CPPWORKER_GPU_LAYERS=99` (all layers on GPU
#     для моделей до 22GB — Qwen3.6-35B-A3B влезет целиком на A10!)
#
# ⚠️ Qwen3.6 garbage tags issue (если повторится на A10):
#   - Qwen3.6 by default в thinking mode → эмитит <think>...</think>
#   - cppworker's reasoning extraction может не разобрать специфичные Qwen3.6 теги
#   - Workaround: CPPWORKER_ENABLE_REASONING=false (уже по дефолту) +
#     per-model profile override через PUT /api/v1/cppworker/model-profiles
#   - Для non-thinking варианта: используйте qwen3-instruct (без -thinking суффикса)
#
# ⚠️ A10 cutoff issue (Cline 120s timeout):
#   - Cline 120s timeout vs cppworker 5+ мин в thinking mode
#   - С r35 image: abort signal flow работает (Round 35b recover() + cgo abort)
#   - Если всё равно cutoff — установить streamingIdleTimeout=120 в config/config.json
#     (см. секция 4 выше)
# =============================================================================
