.gitattributes text eol=lf
* text=auto

# Shell scripts, .env files, YAML, and Dockerfiles must use LF
*.sh text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# ВАЖНО: маска с `*`, а не точное имя. У проекта несколько файлов:
# Dockerfile.gpu, Dockerfile.cpu, Dockerfile.stub, Dockerfile.gpu.86 — правило
# `Dockerfile` их НЕ покрывало, и на машине с core.autocrlf=true они получили бы
# CRLF. В Dockerfile это ломает продолжение строк `\` (классический сбой
# Windows-сборок), поэтому фиксируем LF для всех.
Dockerfile* text eol=lf

# Go source
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Config files
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf

# Documentation
*.md text eol=lf

# R493 (2026-11-15): патчи llama.cpp обязаны иметь LF на любой ОС —
# `git apply` сравнивает контекст побайтово, и CRLF-чекаут ломал их
# прикладывание (при обновлении до 1.0.0 это всплыло на сборке образа).
docker/cppworker/patches/*.patch text eol=lf
