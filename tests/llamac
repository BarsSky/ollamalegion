// TestLlamaCppTransport_ChatNonStreaming проверяет трансляцию OpenAI → Ollama
// для не-стримингового /api/chat.
func TestLlamaCppTransport_ChatNonStreaming(t *testing.T) {
	worker := newMockCppWorkerOpenAI()
	defer worker.Close()

	proxy := createTestProxyForLlamaCppOpenAI(t, worker.server.URL)
	registerModelOnProxy(proxy, "llamacpp-1", "test-model")

	reqBody := map[string]interface{}{
		"model": "test-model",
		"messages": []map[string]string{
			{"role": "user", "content": "Привет!"},
		},
		"stream": false,
	}
	bodyBytes, _ := json.Marshal(reqBody)

	req := httptest.NewRequest("POST", "/api/chat", bytes.NewReader(bodyBytes))
	req.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()

	proxy.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		body, _ := io.ReadAll(rec.Body)
		t.Fatalf("expected 200 OK, got %d: %s", rec.Code, string(body))
	}

	var respData map[string]interface{}
	if err := json.NewDecoder(rec.Result().Body).Decode(&respData); err != nil {
		t.Fatalf("failed to decode response: %v", err)
	}

	// Проверяем Ollama формат ответа
	message, ok := respData["message"].(map[string]interface{})
	if !ok {
		t.Fatalf("response missing 'message' field: %v", respData)
	}
	content, ok := message["content"].(string)
	if !ok || content == "" {
		t.Fatalf("response message content is empty or missing")
	}
	role, ok := message["role"].(string)
	if !ok || role == "" {
		t.Fatalf("response message role is empty or missing")
	}
	if role != "assistant" {
		t.Errorf("expected role='assistant', got '%s'", role)
	}
	if !strings.Contains(content, "Привет") {
		t.Errorf("expected meaningful content, got: %s", content)
	}

	// Проверяем done
	done, ok := respData["done"].(bool)
	if !ok || !done {
		t.Errorf("expected done=true, got done=%v", respData["done"])
	}

	// Проверяем eval_count
	if ec, ok := respData["eval_count"].(float64); ok {
		if ec == 0 {
			t.Log("warning: eval_count is 0")
		}
	}

	t.Logf("✅ OpenAI→Ollama translation: content=%q, role=%s, done=%v", content, role, done)
}

// TestLlamaCppTransport_ChatStreaming проверяет стриминг с OpenAI SSE → Ollama NDJSON
func TestLlamaCppTransport_ChatStreaming(t *testing.T) {
	worker := newMockCppWorkerOpenAI()
	defer worker.Close()

	proxy := createTestProxyForLlamaCppOpenAI(t, worker.server.URL)
	registerModelOnProxy(proxy, "llamacpp-1", "test-model")

	reqBody := map[string]interface{}{
		"model": "test-model",
		"messages": []map[string]string{
			{"role": "user", "content": "Привет!"},
		},
		"stream": true,
	}
	bodyBytes, _ := json.Marshal(reqBody)

	req := httptest.NewRequest("POST", "/api/chat", bytes.NewReader(bodyBytes))
	req.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()

	proxy.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		body, _ := io.ReadAll(rec.Body)
		t.Fatalf("expected 200 OK, got %d: %s", rec.Code, string(body))
	}

	// Читаем NDJSON чанки
	scanner := bufio.NewScanner(rec.Result().Body)
	var foundDone bool
	var collectedContent strings.Builder
	var chunkCount int
	for scanner.Scan() {
		line := scanner.Text()
		if line == "" {
			continue
		}
		chunkCount++
		var chunk map[string]interface{}
		if err := json.Unmarshal([]byte(line), &chunk); err != nil {
			t.Logf("non-JSON chunk: %s", line)
			continue
		}
		if done, ok := chunk["done"].(bool); ok && done {
			foundDone = true
		}
		if msg, ok := chunk["message"].(map[string]interface{}); ok {
			if c, ok := msg["content"].(string); ok {
				collectedContent.WriteString(c)
			}
		}
	}

	t.Logf("chunks received: %d, collected content: %q", chunkCount, collectedContent.String())

	if !foundDone {
		t.Error("streaming response missing done:true")
	}
	if collectedContent.Len() == 0 {
		t.Error("no content collected from streaming chunks")
	}
	content := collectedContent.String()
	if strings.TrimSpace(content) == "**" {
		t.Errorf("streaming content is '**' — expected meaningful text")
	}

	t.Log("✅ OpenAI SSE → Ollama NDJSON streaming translation works")
}

