# ============================================
# WebUI Environment Configuration
# ============================================

# API балансировщика (хост внутри Docker-сети или localhost для локального запуска)
API_HOST=loadbalancer
API_PORT=18081

# Опциональный API токен для аутентификации запросов
API_TOKEN=

# Интервал автообновления данных в WebUI (миллисекунды)
REFRESH_INTERVAL=5000

# WebSocket reconnect параметры
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_INTERVAL_BASE=3000

# Порт nginx внутри контейнера (обычно 80)
NGINX_PORT=80