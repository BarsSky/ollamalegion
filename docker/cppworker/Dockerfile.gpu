# =============================================================================
# CppBackend Worker GPU — реальный llama.cpp + CUDA
# =============================================================================
# Сборка:
#   Под все архитектуры (по умолчанию, multi-arch образ, тэг :gpu-arch_all):
#     docker build -t ollama-legion/cppworker:gpu-arch_all -f docker/cppworker/Dockerfile.gpu --target runtime .
#   Под конкретную архитектуру, например sm_86 (RTX 30xx / A100, тэг :gpu-86):
#     docker build --build-arg CUDA_ARCH=86 \
#       -t ollama-legion/cppworker:gpu-86 -f docker/cppworker/Dockerfile.gpu --target runtime .
#   Через docker-compose (берёт CUDA_ARCH из env/compose):
#     docker compose -f deployments/docker-compose.cppworker.yml --profile gpu up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: llama-builder — сборка libllama.a + libggml*.a с CUDA
# -----------------------------------------------------------------------------

# CUDA_BASE — реестр базового образа CUDA. Объявлен ДО первого FROM: только
# такой ARG доступен в строках FROM. Зеркало по умолчанию (timeweb) отдаёт
# большой слой devel-образа (2.34 GB) со скоростью ~110 KB/s — сборка висит
# часами. Быстрый обход: --build-arg CUDA_BASE=mirror.gcr.io/nvidia/cuda
# (проверено на стенде: 77 MB/s, образ тянется за секунды).
ARG CUDA_BASE=dockerhub.timeweb.cloud/nvidia/cuda

# CUDA_VERSION — версия CUDA в базовом образе. Раньше она была ЛИТЕРАЛОМ
# `12.2.0` в пяти строках FROM, и это молча противоречило комментарию про
# `CUDA_ARCH=all` ниже: CUDA 12.2 не знает архитектуру sm_120 (Blackwell), то
# есть собрать под RTX 50xx на ней нельзя — компилятор падает на
# `Unsupported gpu architecture 'compute_120'`. Для sm_120 нужна 12.8 и новее
# (драйвер 570+; на стенде 617.42). Для прежних GPU (sm_86 у RTX 3070)
# 12.8 тоже подходит, поэтому версия вынесена в аргумент, а не поднята молча:
#     --build-arg CUDA_VERSION=12.8.0 --build-arg CUDA_ARCH=120
ARG CUDA_VERSION=12.2.0

FROM ${CUDA_BASE}:${CUDA_VERSION}-devel-ubuntu22.04 AS llama-builder

# CUDA_ARCH:
#   "all"  — собрать под широкий список архитектур (61;70;75;80;86;89;90;120)
#            используется llama.cpp в CI как fallback, увеличивает размер бинаря
#            и время сборки, но подходит для любых GPU (default)
#   "86"   — только sm_86 (RTX 30xx / A100)
#   "75"   — только sm_75 (Turing)
#   "89"   — только sm_89 (Ada Lovelace)
#   "75;86;89" — список через ";" для нескольких архитектур
ARG CUDA_ARCH="all"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make git cmake ca-certificates ccache && \
    rm -rf /var/lib/apt/lists/*

# ccache setup (Round 15 follow-up 2026-07-29): ccache ускоряет повторные
# сборки llama.cpp в 10-20x. CMake находит ccache через переменные
# CC/CXX (CCACHE_WRAPPER_PATH) или переменную CMAKE_CXX_COMPILER_LAUNCHER.
ENV CCACHE_DIR=/root/.ccache
ENV CCACHE_MAXSIZE=5G
ENV CCACHE_COMPILERCHECK=content
ENV CMAKE_C_COMPILER_LAUNCHER=ccache
ENV CMAKE_CXX_COMPILER_LAUNCHER=ccache

WORKDIR /build/llama.cpp
COPY c/llama.cpp .

RUN git init && git add -A && git -c user.name=docker -c user.email=docker@build commit -m "llama.cpp"

# R214 (2026-10-21): локальный патч llama.cpp — TCP keepalive на сокете раскладки.
#
# c/llama.cpp — git-сабмодуль (закреплён на коммите из CPPWORKER_LLAMA_BUILD),
# поэтому правка живёт отдельным .patch-файлом и применяется на сборке, а не
# коммитом внутри сабмодуля: так патч виден в нашем репозитории и не ломает
# воспроизводимость пина.
#
# ЗАЧЕМ. rpc-server освобождает веса сессии только в деструкторе rpc_server, а он
# срабатывает, когда recv() на сокете вернул ошибку. Без keepalive смерть мастера
# БЕЗ закрытия соединения (пропало питание, выдернули кабель) оставляет на узле
# полумёртвый сокет: VRAM занята весами, а новый клиент не обслуживается (узел
# отдаёт одно соединение за раз). Теперь мёртвая сессия видна за ~1.5-2 минуты,
# веса освобождаются, узел готов к следующей загрузке.
COPY docker/cppworker/patches /tmp/patches
# R218: патчи применяются по порядку и падают громко, если хоть один не встал.
#  0001 — TCP keepalive сокета раскладки (R214);
#  0002 — недоступный RPC-узел больше не GGML_ABORT'ит процесс (R218).
RUN for p in /tmp/patches/*.patch; do \
        git apply "$p" || exit 1; \
    done && rm -rf /tmp/patches

# При CUDA_ARCH=all (или пусто) собираем под широкий список архитектур.
# Иначе пробрасываем значение как есть (например "86", "89" или "75;86;89").
# Round 15 follow-up (2026-07-29): --mount=type=cache,target=/root/.ccache
# персистит ccache между билдами. Без него каждый билд перекомпилирует
# ВСЕ .cu.o/.cpp.o заново (18 мин C++). С ним — только изменённые файлы
# (обычно <1 мин для Go-only изменений).
#
# Round 23 (2026-08-04) FIX: добавлены mode/uid/gid в cache mount.
# Без них BuildKit создаёт cache dir с дефолтным owner (root:root) и mode 0755.
# Проблема в том, что на Docker Desktop (Windows backend) cache mount иногда
# монтируется read-only или с другим uid, что приводит к "ccache: failed to
# create directory" и ccache не работает. mode=0755,uid=0,gid=0 ЯВНО
# указывают writable root-owned cache. Также `id=ccache` для явного
# identifier (позволяет использовать cache-to/cache-from для cross-build
# sharing в будущем).
#
# IMPORTANT: cache mount PERSISTS только в пределах ОДНОЙ buildx builder
# instance. На Docker Desktop при каждом `docker build` создаётся новая
# ephemeral BuildKit instance (default = "docker" driver, in-process),
# cache ТЕРЯЕТСЯ между invocations. Для persistent ccache нужен отдельный
# builder container:
#   docker buildx create --name ollamalegion --driver docker-container --use
#   docker buildx build --builder ollamalegion ...
# С этим ccache реально переиспользуется между билдами (с 20 мин до 1-2 мин).
RUN --mount=type=cache,id=ccache,target=/root/.ccache,mode=0755,uid=0,gid=0 \
    mkdir -p build && cd build && \
    if [ -z "${CUDA_ARCH}" ] || [ "${CUDA_ARCH}" = "all" ]; then \
        # CUDA 12.2 поддерживает sm_50..sm_90. Blackwell (sm_120) — только в CUDA 12.8+.
        GGML_CUDA_ARCH_LIST="50;61;70;75;80;86;89;90" && \
        echo "[llama.cpp] CUDA_ARCH=all -> GGML_CUDA_ARCH_LIST=${GGML_CUDA_ARCH_LIST}"; \
    else \
        GGML_CUDA_ARCH_LIST="${CUDA_ARCH}" && \
        echo "[llama.cpp] CUDA_ARCH=${CUDA_ARCH} -> GGML_CUDA_ARCH_LIST=${GGML_CUDA_ARCH_LIST}"; \
    fi && \
    cmake .. \
      -DGGML_CUDA=ON \
      -DGGML_CUDA_NCCL=OFF \
      # S1 (2026-10-11): RPC-бэкенд llama.cpp. Без него в образе нет цели
      # `rpc-server`, и раскладка слоями между машинами невозможна: мост
      # регистрирует узлы как ggml-устройства, а регистрировать нечего.
      # Версия протокола RPC чувствительна к коммиту, поэтому rpc-server
      # собирается здесь же, тем же исходником и с теми же
      # CUDA_ARCHITECTURES, что libllama — см. docs/architecture/rpc-coordinator.ru.md.
      -DGGML_RPC=ON \
      -DCMAKE_CUDA_ARCHITECTURES="${GGML_CUDA_ARCH_LIST}" \
      -DGGML_CCACHE=ON \
      -DLLAMA_CURL=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF \
      -DBUILD_SHARED_LIBS=OFF \
      # Round 14a: enable LLAMA_BUILD_COMMON для libcommon.a (chat.h, common_chat_*).
      # Default is OFF (только при LLAMA_STANDALONE=ON), но нам нужна libcommon.a
      # для нашего C++ wrapper chat_thinking.cpp.
      -DLLAMA_BUILD_COMMON=ON \
      # R248/B2: libmtmd.a для mmproj passthrough. tools/ собирается и так
      # (LLAMA_STANDALONE=ON → LLAMA_BUILD_TOOLS=ON по умолчанию), флаг
      # LLAMA_BUILD_MTMD фиксирует намерение и оставит mtmd доступным, если
      # tools/ когда-нибудь выключат: standalone-хук сработает только тогда.
      -DLLAMA_BUILD_MTMD=ON \
      # v0.5.16: gemma-4 workaround — её compute-graph с Gated Delta Net hybrid
      # attention даёт split с n_inputs > 30, что триггерит GGML_ASSERT в
      # ggml-backend.cpp:1367 (SIGABRT). Upstream PR #6137 сделал эту константу
      # variable (=GGML_MAX_SRC), но в нашей форкнутой версии она hard-coded.
      # Бампаем до 128 — покрывает gemma-4 и оставляет запас для будущих моделей.
      -DGGML_SCHED_MAX_SPLIT_INPUTS=128 && \
    cmake --build . --config Release -j$(nproc) && \
    ccache -s | tail -5

# -----------------------------------------------------------------------------
# Stage 2: bridge-builder — сборка libollamalegion_bridge.a
# -----------------------------------------------------------------------------
FROM ${CUDA_BASE}:${CUDA_VERSION}-devel-ubuntu22.04 AS bridge-builder

# Round 14a (2026-07-28): nlohmann-json3-dev для c/llama.cpp/common/
# (nlohmann/json_fwd.hpp, nlohmann/json.hpp — нужны для chat.h).
# Обычно предустановлен в Linux системах (Ubuntu 22.04 universe repo).
# Без этого chat_thinking.cpp не скомпилируется: "fatal error:
# nlohmann/json_fwd.hpp: No such file or directory".
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    nlohmann-json3-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build/bridge
# Round 14a (2026-07-28): копируем csrc/ для C++ wrapper chat_thinking.cpp
# (native enable_thinking через common::chat). CMakeLists.txt ссылается
# на csrc/chat_thinking.cpp — без COPY csrc/ сборка падает с "Cannot find
# source file: csrc/chat_thinking.cpp".
COPY c/bridge/bridge.h c/bridge/bridge.c c/bridge/CMakeLists.txt ./
COPY c/bridge/csrc ./csrc/

COPY --from=llama-builder /build/llama.cpp/include /build/llama.cpp/include
COPY --from=llama-builder /build/llama.cpp/ggml/include /build/llama.cpp/ggml/include
COPY --from=llama-builder /build/llama.cpp/ggml/src/ggml-cpu /build/llama.cpp/ggml/src/ggml-cpu
# Round 14a: c/llama.cpp/common/ нужен для chat.h (common_chat_templates_apply).
# Без этого chat_thinking.cpp не скомпилируется ("fatal error: chat.h: No such file").
COPY --from=llama-builder /build/llama.cpp/common /build/llama.cpp/common
COPY --from=llama-builder /build/llama.cpp/build/src /build/llama.cpp/build/src
COPY --from=llama-builder /build/llama.cpp/build/ggml/src /build/llama.cpp/build/ggml/src
# Round 14a: libcommon.a содержит реализацию common_chat_templates_apply и других
# C++ API. Без неё линковка chat_thinking.cpp упадёт (undefined reference).
COPY --from=llama-builder /build/llama.cpp/build/common /build/llama.cpp/build/common
# R248/B2: mmproj passthrough — заголовки tools/mtmd (clip.h/mtmd.h) для
# csrc/vision_mtmd.cpp и сама libmtmd.a для линковки bridge.
COPY --from=llama-builder /build/llama.cpp/tools/mtmd /build/llama.cpp/tools/mtmd
COPY --from=llama-builder /build/llama.cpp/build/tools/mtmd /build/llama.cpp/build/tools/mtmd
# R248/B3: libmtmd ссылается на vendor-hash (sha256 id bitmap'ов) — без этого
# архива финальная линковка падает на hash_sha256_hex.
COPY --from=llama-builder /build/llama.cpp/build/vendor/hash /build/llama.cpp/build/vendor/hash

RUN mkdir -p build && cd build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --config Release

# -----------------------------------------------------------------------------
# Stage 3: go-builder — Go сборка с CGo
# -----------------------------------------------------------------------------
FROM ${CUDA_BASE}:${CUDA_VERSION}-devel-ubuntu22.04 AS go-builder

ARG GO_VERSION=1.24.3
# GO_DOWNLOAD_BASE — откуда брать дистрибутив Go (без завершающего «/»).
#
# ЗАЧЕМ ПАРАМЕТР (живой случай 2026-10-16). Сборка cppworker упала на этом шаге с
# `wget ... exit code: 4`, и вместе с ней встали ВСЕ сборки воркера: сеть стенда
# перестала видеть go.dev и dl.google.com (проверено пробой из контейнера:
# «wget: download timed out»), при этом зеркало mirrors.aliyun.com отвечало.
# Раньше смена источника была возможна только правкой Dockerfile — то есть
# недоступность одного хоста блокировала выпуск образов.
#
# Дефолт оставлен прежним (официальный go.dev), чтобы поведение сборки вне стенда
# не менялось. Для стенда: --build-arg GO_DOWNLOAD_BASE=https://mirrors.aliyun.com/golang
ARG GO_DOWNLOAD_BASE=https://go.dev/dl

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates gcc g++ make libc6-dev && \
    wget -q --retry-connrefused --waitretry=5 --tries=5 --timeout=30 "${GO_DOWNLOAD_BASE}/go${GO_VERSION}.linux-amd64.tar.gz" -O /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV GOMODCACHE="/go/pkg/mod"

WORKDIR /build

COPY go.mod go.sum ./
# Round 15 follow-up (2026-07-29): BuildKit cache mount для Go modules.
# Кеш /go/pkg/mod + /root/.cache/go-build персистится между билдами.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify

COPY . .

# Optimized copy: avoid copying the entire /build/llama.cpp/build tree
# (which can be several GB and hangs the Legacy builder). Copy only the
# static library directories needed for linking.
COPY --from=llama-builder /build/llama.cpp/build/src /build/c/llama.cpp/build/src
COPY --from=llama-builder /build/llama.cpp/build/ggml/src /build/c/llama.cpp/build/ggml/src
# Round 14a follow-up (2026-07-29): добавляем build/common для libllama-common.a +
# libllama-common-base.a. Без этой строки линкер Go-этапа не находит эти либы
# (`/usr/bin/ld: cannot find -lllama-common: No such file or directory`),
# хотя CGO_LDFLAGS на них ссылается. В bridge-builder COPY уже есть
# (line ~99), но это другой stage — каждый stage изолирован.
COPY --from=llama-builder /build/llama.cpp/build/common /build/c/llama.cpp/build/common
# R248/B2: libmtmd.a для финальной Go-линковки (bridge.a вызывает mtmd_*).
COPY --from=llama-builder /build/llama.cpp/build/tools/mtmd /build/c/llama.cpp/build/tools/mtmd
# R248/B3: vendor-hash нужен libmtmd (sha256 id bitmap'ов).
COPY --from=llama-builder /build/llama.cpp/build/vendor/hash /build/c/llama.cpp/build/vendor/hash
COPY --from=llama-builder /build/llama.cpp/include /build/c/llama.cpp/include
COPY --from=llama-builder /build/llama.cpp/ggml/include /build/c/llama.cpp/ggml/include
COPY --from=llama-builder /build/llama.cpp/ggml/src/ggml-cpu /build/c/llama.cpp/ggml/src/ggml-cpu
COPY --from=bridge-builder /build/bridge/build /build/c/bridge/build

ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-DGGML_USE_CUDA -I/build/c/llama.cpp/include -I/build/c/llama.cpp/ggml/include -I/build/c/llama.cpp/ggml/src/ggml-cpu -I/build/c/bridge -I/usr/local/cuda/include -I/usr/local/cuda/targets/x86_64-linux/include -fopenmp"
ENV CGO_LDFLAGS="-L/build/c/llama.cpp/build/src -L/build/c/llama.cpp/build/ggml/src -L/build/c/llama.cpp/build/ggml/src/ggml-rpc -L/build/c/llama.cpp/build/ggml/src/ggml-cuda -L/build/c/llama.cpp/build/common -L/build/c/llama.cpp/build/tools/mtmd -L/build/c/llama.cpp/build/vendor/hash -L/build/c/bridge/build -L/usr/local/cuda/lib64 -L/usr/local/cuda/lib64/stubs -Wl,--start-group -lvendor-hash -lmtmd -lllama -lggml -lggml-cpu -lggml-base -lggml-cuda -lggml-rpc -lllama-common -lllama-common-base -lollamalegion_bridge -Wl,--end-group -lcublas -lcublasLt -lcudart -lcuda -lstdc++ -lm -lpthread -fopenmp"
# -lggml-rpc обязателен при GGML_RPC=ON: реестр бэкендов в libggml.a ссылается
# на ggml_backend_rpc_reg, и без этой библиотеки линковка падает на
# "undefined reference to `ggml_backend_rpc_reg'".
# ВНИМАНИЕ НА ПУТЬ: RPC-бэкенд собирается в подкаталог
# (build/ggml/src/ggml-rpc/libggml-rpc.a), поэтому -L на ggml/src недостаточно.

# GOMAXPROCS=2 ограничивает параллелизм компиляции Go,
# чтобы уложиться в доступную RAM при сборке в Docker Desktop / WSL2.
# R83 (2026-09-28): версия сборки в pkg/version — стартовая запись лога
# cppworker сообщает тег/коммит (см. cmd/cppworker/main.go).
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOMAXPROCS=2 \
    go build -trimpath \
    -ldflags "-w -s -X ollama-loadbalancer/pkg/version.Commit=${GIT_COMMIT} -X ollama-loadbalancer/pkg/version.BuildDate=${BUILD_DATE}" \
    -o cppworker ./cmd/cppworker

# -----------------------------------------------------------------------------
# Stage 3.5: Round 13 + 15.1 regression tests (build + run)
# -----------------------------------------------------------------------------
# Компилирует и запускает c/bridge/tests/test_batch_n_tokens (Round 13) +
# test_batched_batch (Round 15.1). Ломает build если какой-то из
# build_batch_* забыл выставить batch.n_tokens (Round 13/15.1 баг).
# Полная документация:
#   c/bridge/tests/test_batch_n_tokens.c
#   c/bridge/tests/test_batched_batch.c
FROM ${CUDA_BASE}:${CUDA_VERSION}-devel-ubuntu22.04 AS bridge-tests

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends cmake gcc g++ && \
    rm -rf /var/lib/apt/lists/*

COPY c/bridge /build/c/bridge
COPY --from=llama-builder /build/llama.cpp /build/llama.cpp

WORKDIR /build/c/bridge/tests
RUN mkdir -p build && cd build && \
    cmake -DCOMMON_LIB=/build/llama.cpp/build/common/libllama-common.a .. && \
    make test_batch_n_tokens test_batched_batch && \
    ./test_batch_n_tokens && \
    ./test_batched_batch

# -----------------------------------------------------------------------------
# Stage 4: runtime
# -----------------------------------------------------------------------------
FROM ${CUDA_BASE}:${CUDA_VERSION}-runtime-ubuntu22.04 AS runtime

# R114 (2026-10-13): версия/коммит llama.cpp, которую узел сообщает балансеру.
#
# ЗАЧЕМ В ОБРАЗЕ, А НЕ ТОЛЬКО В ОКРУЖЕНИИ. Протокол RPC версионно-чувствителен:
# мастер и донор обязаны быть собраны одним коммитом llama.cpp, иначе соединение
# даёт расхождение (вплоть до abort). Балансер сравнивает эту строку у узлов
# группы раскладки (types.Backend.BuildInfo → composition.checkVersionMismatch).
# Значение пекут в образ из того же исходника, что и libllama/rpc-server, поэтому
# оно не может разойтись с реально собранным кодом; окружение может переопределить
# его на запуске (см. CPPWORKER_LLAMA_BUILD в compose).
ARG LLAMA_BUILD=unknown
ENV CPPWORKER_LLAMA_BUILD=${LLAMA_BUILD}
# R167 (2026-10-17): ФАКТ для сверки с env. compose переопределяет CPPWORKER_LLAMA_BUILD,
# и тогда расхождение «намерение vs собранное» становится невидимым. Эта переменная
# не переопределяется — её значение и есть то, что реально в образе.
ENV CPPWORKER_LLAMA_BUILD_BAKED=${LLAMA_BUILD}

# R135 (2026-10-16): под какие архитектуры CUDA собран образ.
#
# ЗАЧЕМ В ОБРАЗЕ, А НЕ ТОЛЬКО В ОКРУЖЕНИИ. Образ переносят на другую машину
# (docker save/load), и там он обязан сам сообщать свои архитектуры: иначе
# единственным «детектором» несовместимости остаётся SIGABRT на первом
# GPU-ядре («CUDA error: no kernel image is available for execution on the
# device»), который уносит процесс вместе с загруженной моделью, а оператор
# видит «backend недоступен» и загрузку с другими параметрами. cppworker
# сравнивает это значение с compute capability карты и пишет понятную причину
# (см. internal/cppbackend/cuda_arch_guard.go).
#
# ARG объявлен повторно: build-arg виден только в той стадии, где объявлен.
ARG CUDA_ARCH=unknown
ENV CPPWORKER_CUDA_ARCH_BUILT=${CUDA_ARCH}

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip libgomp1 && \
    pip3 install --no-cache-dir huggingface_hub && \
    rm -rf /var/lib/apt/lists/*

COPY docker/cppworker/entrypoint.sh /entrypoint.sh
COPY docker/cppworker/register-with-balancer.sh /register-with-balancer.sh
    # Round 7: cppworker ApiToken in registration payload
RUN chmod +x /entrypoint.sh /register-with-balancer.sh
COPY --from=go-builder /build/cppworker .
# S1 (2026-10-11): rpc-server — узел раскладки слоями между машинами.
# Собран тем же коммитом llama.cpp и с теми же CUDA_ARCHITECTURES, что libllama:
# протокол RPC версионно-чувствителен, и «просто rpc-server из другого выпуска»
# даёт расхождение, которое ловится только на живом стенде.
# ВНИМАНИЕ НА ИМЯ: цель llama.cpp называется `ggml-rpc-server`
# (c/llama.cpp/tools/rpc/CMakeLists.txt: set(TARGET ggml-rpc-server)), хотя в
# документации llama.cpp её зовут rpc-server. Копируем под коротким именем
# /app/rpc-server — на него ссылается docker-compose.rpc-node.yml.
# COPY стоит ДО chown -R appuser:appgroup /app ниже, чтобы бинарь сразу достался appuser.
COPY --from=llama-builder /build/llama.cpp/build/bin/ggml-rpc-server /app/rpc-server

# R119 (2026-10-15): /app/config создаётся ЗАРАНЕЕ и принадлежит appuser.
#
# ЗАЧЕМ. В этот каталог cppworker пишет настройки, которые оператор меняет из
# WebUI (cppworker-defaults.json и cppworker-runtime-overrides.json), и он должен
# быть смонтирован томом — иначе правка живёт до первого пересоздания контейнера
# (`docker compose up`), и env-переменная CPPWORKER_* на рестарте затирает её.
#
# Docker заполняет СВЕЖИЙ именованный том содержимым и правами образа по этому
# пути; если каталога в образе нет, точка монтирования создаётся от root, и
# appuser получает «permission denied» на запись (проверено живьём: попытка
# сохранить переопределение в /app/.cache давала именно это).
RUN mkdir -p /app/models /app/config && \
    groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -m -s /bin/sh appuser && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 18092

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD /app/cppworker -healthcheck || exit 1

# === Runtime defaults (override via compose/env) ===
# CPPWORKER_PORT:        18092 for GPU, 18091 for CPU (legacy), 18093 for stub.
# CPPWORKER_HOST:        bind address (0.0.0.0 = accept from any interface).
# CPPWORKER_BALANCER_URL/CPPWORKER_BALANCER_TOKEN: enable Go auto-registration.
# If only BALANCER_URL is set, entrypoint.sh copies it into CPPWORKER_BALANCER_URL.
ENV CPPWORKER_PORT=18092 \
    CPPWORKER_HOST=0.0.0.0 \
    CPPWORKER_BALANCER_URL="" \
    CPPWORKER_BALANCER_TOKEN="" \
    CPPWORKER_ADVERTISE_HOST="" \
    CPPWORKER_ADVERTISE_PORT=18092 \
    CPPWORKER_REGISTER_RETRY_INTERVAL=30s \
    CPPWORKER_REGISTER_HEARTBEAT=60s

ENV HF_HOME=/app/.cache/huggingface
ENV HF_TOKEN=""
ENV HF_AUTO_DOWNLOAD_REPO=""
ENV HF_AUTO_DOWNLOAD_FILE=""
ENV HF_AUTO_DOWNLOAD_QUANT="Q4_K_M"
ENV HF_MIRROR=""

ENTRYPOINT ["/entrypoint.sh"]

LABEL org.opencontainers.image.title="Ollama Legion CppBackend Worker (GPU)"
LABEL org.opencontainers.image.description="GGUF model inference server with real llama.cpp (CUDA_ARCH=${CUDA_ARCH})"
LABEL org.opencontainers.image.vendor="OllamaLegion"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.source="https://github.com/BarsSky/ollamalegion"
