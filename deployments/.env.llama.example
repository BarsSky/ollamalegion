# ============================================================
# Переменные окружения для docker-compose.llama.cpp.yml
# ============================================================
# Скопируйте в .env и отредактируйте перед запуском:
#   cp .env.llama.example .env
#   docker compose -f docker-compose.llama.cpp.yml up -d
# ============================================================

# === Путь к GGUF-моделям на хосте ===
# Монтируется как /models в контейнер cppworker (read-only)
MODELS_DIR=/data/models

# === URL балансера ===
# API-порт балансера (18081) — используется для авторегистрации
# LAN:  http://192.0.2.10:18081
# WAN:  https://balancer.your-domain.com:18081
BALANCER_URL=http://192.0.2.10:18081

# === Имя узла (уникальный ID для балансера) ===
NODE_NAME=llama-gpu-node-1

# === Порты ===
LLAMA_HTTP_PORT=18091
LLAMA_GRPC_PORT=19000
AGENT_PORT=18032

# === Количество GPU (для docker compose device reservation) ===
GPU_COUNT=1

# === Интервалы агента (секунды) ===
HEARTBEAT_INTERVAL=30
COLLECT_INTERVAL=15

# === API токен безопасности ===
# Такой же, как на балансере, для авторизованной регистрации
API_TOKEN=

# === Параметры llama.cpp ===
# Пробрасываются как переменные окружения в cppworker
LLAMA_N_GPU_LAYERS=-1
LLAMA_CTX_SIZE=8192
LLAMA_BATCH_SIZE=512
LLAMA_FLASH_ATTN=true
LLAMA_NUMA=false
LLAMA_MMAP=true
LLAMA_MLOCK=false
LLAMA_TENSOR_SPLIT=0
LLAMA_MAIN_GPU=0
LLAMA_THREADS=0
LLAMA_IDLE_UNLOAD=30m
LLAMA_ENFORCE_REPLICATION=false

# === Метки узла (key=value через запятую) ===
NODE_LABELS=zone=lan

# === RPC координатор (опционально) ===
RPC_COORDINATOR_URL=
RPC_WORKER_PORT=18050