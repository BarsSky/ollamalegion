{
  "loadBalancer": {
    "host": "0.0.0.0",
    "port": 18080,
    "apiPort": 18081,
    "statePath": "data/state.json"
  },
  "backends": [],
  "balancing": {
    "algorithm": "resource-aware",
    "modelAffinity": true,
    "sessionStickiness": true,
    "healthCheckInterval": 10,
    "metricsInterval": 5,
    "requestTimeout": 120,
    "firstByteTimeout": 30,
    "streamingIdleTimeout": 120,
    "queueTimeout": 300,
    "queueMaxSize": 100,
    "queueWorkers": 4,
    "sessionTTL": 900,
    "prewarm": {
      "enabled": true,
      "triggerLoadThreshold": 0.70,
      "maxPrewarmPerCycle": 2,
      "checkIntervalSec": 10
    },
    "modelInstances": {
      "defaultMinInstances": 1,
      "defaultMaxInstances": 3,
      "idleUnloadAfter": "10m"
    },
    "scoring": {
      "modelAlreadyLoaded": 0.15,
      "modelLoadingCost": 0.10,
      "queueDepthPenalty": 0.05,
      "errorRatePenalty": 0.05,
      "predictionBonus": 0.10
    },
    "syncModelLoad": {
      "enabled": true,
      "timeout": "30s"
    },
    "resourceReservation": {
      "gpuHeadroomPercent": 15,
      "ramHeadroomPercent": 10
    }
  },
  "resources": {
    "gpu": {
      "maxUsagePercent": 90,
      "maxVramUsagePercent": 85,
      "maxTemperature": 85
    },
    "cpu": {
      "maxUsagePercent": 80
    },
    "memory": {
      "maxUsagePercent": 85
    },
    "disk": {
      "minFreeMB": 10240
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "api": {
    "rateLimit": 100,
    "rateBurst": 200
  },
  "tls": {
    "enabled": false,
    "certFile": "certs/server.crt",
    "keyFile": "certs/server.key",
    "minVersion": "TLS12",
    "autoCert": true
  },
  "auth": {
    "enabled": false,
    "tokens": [
      "your-master-token-here-change-in-production"
    ],
    "headerName": "X-API-Token"
  }
}